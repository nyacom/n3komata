+static void n3komata_write_super_expert_profile(const n3komata_super_expert_profile & profile, const char * path) {
+    std::ofstream output(path);
+    if (!output) {
+        throw std::runtime_error(std::string("failed to write activation profile: ") + path);
+    }
+    output << "layer,expert_id,max_abs_down_output,route_observations\n";
+    for (const auto & [key, stat] : profile.experts) {
+        output << key.first << ',' << key.second << ',' << std::setprecision(10)
+               << stat.max_abs_down_output << ',' << stat.route_observations << '\n';
+    }
+    output.close();
+
+    const std::string hidden_path = std::string(path) + ".hidden.csv";
+    std::ofstream hidden_output(hidden_path);
+    if (!hidden_output) {
+        throw std::runtime_error("failed to write hidden activation profile: " + hidden_path);
+    }
+    hidden_output << "layer,stage,max_abs_hc_combine,activation_values_observed\n";
+    for (const auto & [key, stat] : profile.hidden_state_max_by_layer_stage) {
+        hidden_output << key.first << ',' << (key.second == 0 ? "after_attn" : "after_ffn") << ','
+                      << std::setprecision(10) << stat.first << ',' << stat.second << '\n';
+    }
+}
