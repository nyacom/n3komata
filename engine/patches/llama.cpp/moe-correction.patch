@@ -0,0 +1,226 @@
+#include "llama-moe-cache-report.h"
+
+#include "llama-impl.h"
+
+#include <cinttypes>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+
+namespace llama_moe_cache_report {
+
+void log_cache_stats(
+        const cache_stats & small,
+        const cache_stats & large,
+        const std::vector<cache_stats> & by_layer,
+        const std::vector<cutoff_stats> & cutoff_by_layer,
+        bool cutoff_enabled,
+        int32_t cutoff_min_k) {
+    auto log = [](const char * name, const cache_stats & stats) {
+        const size_t requests = stats.hits + stats.misses;
+        if (requests == 0) {
+            return;
+        }
+        LLAMA_LOG_INFO("llama_moe_cache: %s: hits = %zu, misses = %zu, hit rate = %.2f%%, uploaded = %.2f MiB\n",
+                name, stats.hits, stats.misses, 100.0*stats.hits/requests, stats.bytes/1024.0/1024.0);
+    };
+    log("ubatch <= 8", small);
+    log("ubatch  > 8", large);
+
+    for (size_t il = 0; il < by_layer.size(); ++il) {
+        const cache_stats & stats = by_layer[il];
+        if (stats.hits + stats.misses == 0) {
+            continue;
+        }
+        LLAMA_LOG_INFO("n3komata_moe_layer: layer=%zu expert_requests=%zu cache_hits=%zu cache_misses=%zu uploaded=%.2f MiB expert_executions=%zu selected_routes=%zu\n",
+                il, stats.hits + stats.misses, stats.hits, stats.misses, stats.bytes/1024.0/1024.0,
+                stats.executions, stats.selected_routes);
+        if (!cutoff_enabled) {
+            continue;
+        }
+        const cutoff_stats & cutoff = cutoff_by_layer[il];
+        LLAMA_LOG_INFO("n3komata_moe_fallback_cutoff: layer=%zu callbacks=%" PRIu64
+                " route_slots=%" PRIu64 " unique_fallback_experts=%" PRIu64
+                " fallback_route_slots=%" PRIu64 " admitted_misses=%" PRIu64
+                " estimated_budget_ms=%.3f estimated_upload_ms=%.3f actual_upload_ms=%.3f\n",
+                il, cutoff.callbacks, cutoff.route_slots, cutoff.unique_fallback_experts,
+                cutoff.fallback_route_slots, cutoff.admitted_misses,
+                cutoff.estimated_budget_us/1000.0, cutoff.estimated_upload_us/1000.0,
+                cutoff.actual_upload_us/1000.0);
+        if (cutoff_min_k > 0) {
+            LLAMA_LOG_INFO("n3komata_moe_fallback_min_k: layer=%zu min_k=%d forced_expert_misses=%" PRIu64 "\n",
+                    il, cutoff_min_k, cutoff.min_k_forced_expert_misses);
+        }
+    }
+}
+
+void log_dynamic_stats(
+        const std::vector<dynamic_policy> & policies,
+        const std::vector<dynamic_stats> & stats_by_layer) {
+    for (size_t il = 0; il < stats_by_layer.size(); ++il) {
+        const dynamic_policy & policy = policies[il];
+        const dynamic_stats & stats = stats_by_layer[il];
+        if (policy.mode == 0 || stats.tokens == 0) {
+            continue;
+        }
+        std::ostringstream histogram;
+        bool first = true;
+        for (size_t k = 0; k < stats.selected_k_histogram.size(); ++k) {
+            if (stats.selected_k_histogram[k] == 0) {
+                continue;
+            }
+            histogram << (first ? "" : ",") << k << ":" << stats.selected_k_histogram[k];
+            first = false;
+        }
+        LLAMA_LOG_INFO("n3komata_moe_dynamic_k: layer=%zu tokens=%zu mean_required_k=%.3f mean_selected_k=%.3f mean_cache_extra_k=%.3f invalid_tokens=%zu histogram=%s\n",
+                il, stats.tokens,
+                (double) stats.required_k_sum/stats.tokens,
+                (double) stats.selected_k_sum/stats.tokens,
+                (double) stats.cache_extra_sum/stats.tokens,
+                stats.invalid_tokens, histogram.str().c_str());
+        if (policy.mode == 3) {
+            std::ostringstream protected_ids;
+            for (size_t i = 0; i < policy.protected_experts.size(); ++i) {
+                protected_ids << (i == 0 ? "" : ",") << policy.protected_experts[i];
+            }
+            LLAMA_LOG_INFO("n3komata_moe_protected: layer=%zu experts=%s seen=%zu kept=%zu substitutions=%zu tokens=%zu\n",
+                    il, protected_ids.str().c_str(), stats.protected_seen, stats.protected_kept,
+                    stats.protected_substitutions, stats.tokens);
+        }
+    }
+}
+
+void log_cache_profile(bool enabled, const std::vector<cache_profile_stats> & stats_by_layer) {
+    if (!enabled) {
+        return;
+    }
+    for (size_t il = 0; il < stats_by_layer.size(); ++il) {
+        const cache_profile_stats & stats = stats_by_layer[il];
+        if (stats.samples == 0) {
+            continue;
+        }
+        LLAMA_LOG_INFO("n3komata_moe_occupancy: layer=%zu samples=%zu mean_layer_resident=%.2f max_layer_resident=%zu mean_group_occupied=%.2f max_group_occupied=%zu evictions=%zu\n",
+                il, stats.samples, (double) stats.layer_resident_sum/stats.samples, stats.layer_resident_max,
+                (double) stats.group_occupied_sum/stats.samples, stats.group_occupied_max, stats.evictions);
+    }
+}
+
+void log_transition_prefetch(
+        bool enabled,
+        std::vector<transition_prefetch_stats> & stats_by_layer,
+        const std::vector<std::vector<int32_t>> & pending_by_layer,
+        std::vector<bool> & pending_valid_by_layer) {
+    if (!enabled) {
+        return;
+    }
+    for (size_t il = 0; il < stats_by_layer.size(); ++il) {
+        transition_prefetch_stats & stats = stats_by_layer[il];
+        if (pending_valid_by_layer[il]) {
+            stats.unobserved_batches++;
+            stats.unused_experts += pending_by_layer[il].size();
+            pending_valid_by_layer[il] = false;
+        }
+        if (stats.prediction_batches == 0) {
+            continue;
+        }
+        LLAMA_LOG_INFO("n3komata_moe_transition_prefetch: layer=%zu batches=%" PRIu64
+            " candidates=%" PRIu64 " bytes=%" PRIu64 " prefetch_ms=%.3f observed_batches=%" PRIu64
+            " router_hits=%" PRIu64 " selected_hits=%" PRIu64 " fill_hits=%" PRIu64
+            " unused=%" PRIu64 " unobserved=%" PRIu64 " async_hint_ms=%.3f async_touch_ms=%.3f"
+            " async_wait_ms=%.3f async_worker_jobs=%" PRIu64
+            " async_worker_active_ms=%.3f async_worker_overlap_ms=%.3f"
+            " async_worker_ready_ahead_ms=%.3f async_worker_lead_ms=%.3f async_worker_queue_ms=%.3f"
+            " async_read_faults=%" PRIu64 " async_read_minor_faults=%" PRIu64
+            " async_read_pages=%" PRIu64 " async_read_mib=%.2f\n",
+            il, stats.prediction_batches, stats.predicted_experts, stats.predicted_bytes,
+            stats.prefetch_us/1000.0, stats.observed_batches, stats.router_hits,
+            stats.selected_hits, stats.fill_hits, stats.unused_experts, stats.unobserved_batches,
+            stats.async_hint_us/1000.0, stats.async_touch_us/1000.0, stats.async_wait_us/1000.0,
+            stats.async_worker_jobs, stats.async_worker_active_us/1000.0,
+            stats.async_worker_overlap_us/1000.0, stats.async_worker_ready_ahead_us/1000.0,
+            stats.async_worker_lead_us/1000.0, stats.async_worker_queue_us/1000.0,
+            stats.async_read_faults, stats.async_read_minor_faults, stats.async_read_pages,
+            stats.async_read_bytes/1024.0/1024.0);
+    }
+}
+
+void log_ple_cache_admission(
+        bool enabled,
+        int32_t after_layer,
+        int32_t target_layer,
+        const std::vector<ple_admission_event> & events,
+        std::vector<int64_t> & pending_event_by_layer,
+        uint64_t & unconsumed_batches) {
+    if (!enabled) {
+        return;
+    }
+    for (int64_t & pending : pending_event_by_layer) {
+        if (pending >= 0) {
+            unconsumed_batches++;
+            pending = -1;
+        }
+    }
+
+    uint64_t candidate_ids = 0;
+    uint64_t inserted = 0;
+    uint64_t already_resident = 0;
+    uint64_t used_routes = 0;
+    uint64_t inserted_used_routes = 0;
+    uint64_t inserted_executed_routes = 0;
+    uint64_t uploaded_bytes = 0;
+    uint64_t upload_wall_us = 0;
+    uint64_t source_copy_us = 0;
+    uint64_t source_copy_thread_cpu_us = 0;
+    uint64_t observed = 0;
+    for (const ple_admission_event & event : events) {
+        candidate_ids += event.candidates.size();
+        inserted += event.inserted.size();
+        already_resident += event.already_resident;
+        used_routes += event.used_routes;
+        inserted_used_routes += event.inserted_used_routes;
+        inserted_executed_routes += event.inserted_executed_routes;
+        uploaded_bytes += event.uploaded_bytes;
+        upload_wall_us += event.upload_wall_us;
+        source_copy_us += event.source_copy_us;
+        source_copy_thread_cpu_us += event.source_copy_thread_cpu_us;
+        observed += event.target_batch != UINT64_MAX;
+    }
+    LLAMA_LOG_INFO("n3komata_ple_cache_admission: after_layer=%d target_layer=%d batches=%zu observed=%" PRIu64
+            " candidates=%" PRIu64 " inserted=%" PRIu64 " already_resident=%" PRIu64
+            " used_routes=%" PRIu64 " inserted_used_routes=%" PRIu64 " inserted_executed_routes=%" PRIu64
+            " upload_mib=%.2f upload_wall_ms=%.3f source_copy_ms=%.3f source_copy_thread_cpu_ms=%.3f unconsumed=%" PRIu64 "\n",
+            after_layer, target_layer, events.size(), observed,
+            candidate_ids, inserted, already_resident, used_routes, inserted_used_routes, inserted_executed_routes,
+            uploaded_bytes/1024.0/1024.0, upload_wall_us/1000.0, source_copy_us/1000.0,
+            source_copy_thread_cpu_us/1000.0, unconsumed_batches);
+
+    const char * trace_path = std::getenv("N3KOMATA_PLE_EXPERT_CACHE_ADMISSION_TRACE");
+    if (trace_path == nullptr || trace_path[0] == '\0') {
+        return;
+    }
+    std::ofstream trace(trace_path);
+    if (!trace) {
+        LLAMA_LOG_WARN("n3komata_ple_cache_admission: failed to write trace '%s'\n", trace_path);
+        return;
+    }
+    auto join_ids = [](const std::vector<int32_t> & ids) {
+        std::ostringstream out;
+        for (size_t i = 0; i < ids.size(); ++i) {
+            out << (i == 0 ? "" : ";") << ids[i];
+        }
+        return out.str();
+    };
+    trace << "after_batch,target_batch,after_layer,target_layer,phase,candidate_count,candidate_ids,already_resident,inserted_count,inserted_ids,used_routes,inserted_used_routes,inserted_executed_routes,upload_bytes,upload_wall_us,source_copy_us,source_copy_thread_cpu_us\n";
+    for (const ple_admission_event & event : events) {
+        trace << event.after_batch << ','
+              << (event.target_batch == UINT64_MAX ? -1 : (int64_t) event.target_batch) << ','
+              << event.after_layer << ',' << event.target_layer << ',' << event.phase << ','
+              << event.candidates.size() << ',' << join_ids(event.candidates) << ','
+              << event.already_resident << ',' << event.inserted.size() << ',' << join_ids(event.inserted) << ','
+              << event.used_routes << ',' << event.inserted_used_routes << ',' << event.inserted_executed_routes << ','
+              << event.uploaded_bytes << ',' << event.upload_wall_us << ',' << event.source_copy_us << ','
+              << event.source_copy_thread_cpu_us << '\n';
+    }
+}
+
+} // namespace llama_moe_cache_report
