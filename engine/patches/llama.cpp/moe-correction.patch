+    if (!upload_path_reported) {
+        const auto * first_buffer = tensor_buffers.empty() ? nullptr : tensor_buffers.front()->dev_buffer.get();
+        const uint32_t memory_flags = first_buffer ? (uint32_t) first_buffer->memory_property_flags : 0;
+        GGML_LOG_INFO("ggml_vulkan: n3komata upload requested=%s selected=%s host_ptr=%d memory_flags=0x%x items=%zu bytes=%zu direct_copy_threads=%d\n",
+            prefer_direct_host ? "direct-host" : "batch-staging",
+            direct_host ? "direct-host" : "batch-staging",
+            first_buffer && first_buffer->ptr != nullptr, memory_flags, n_items, staging_size,
