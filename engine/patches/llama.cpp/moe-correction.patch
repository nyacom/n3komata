+            << sample.workgroup_denoms[0] << ',' << sample.workgroup_denoms[1] << ',' << sample.workgroup_denoms[2] << ','
+            << sample.push_constant_word_count;
+        for (const uint32_t word : sample.push_constant_words) out << ',' << word;
+        out << ',' << sample.gpu_start_ticks << ',' << sample.gpu_end_ticks << ',';
+        if (std::isfinite((double) gpu_start_host_ns) && std::isfinite((double) gpu_end_host_ns)) {
+            out << std::fixed << std::setprecision(0) << (double) gpu_start_host_ns << ',' << (double) gpu_end_host_ns;
+        } else {
+            out << ',';
+        }
+        out << ',' << std::fixed << std::setprecision(3) << gpu_duration_ns / 1000.0 << ',';
+        if (std::isfinite(gap_us)) out << gap_us;
+        out << ',' << sample.cpu_record_start_ns << ',' << sample.cpu_record_end_ns << ',' << cpu_record_us << ',';
+        if (submit_start_ns) out << submit_start_ns;
+        out << ',';
+        if (submit_end_ns) out << submit_end_ns;
+        out << ',';
+        if (std::isfinite(record_to_submit_us)) out << record_to_submit_us;
+        out << ',';
+        if (std::isfinite(submit_to_gpu_us)) out << submit_to_gpu_us;
