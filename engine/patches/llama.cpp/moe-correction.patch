+#pragma once
+
+#include "llama-moe-cache-io-profile.h"
+
+#include "ggml-backend.h"
+
+#include <cstddef>
+#include <cstdint>
+#include <fstream>
+#include <vector>
+
+namespace llama_moe_cache_trace {
+
+struct route_row {
+    int32_t layer = 0;
+    uint64_t batch = 0;
+    int64_t token = 0;
+    size_t rank = 0;
+    int32_t expert = -1;
+    float router_weight = 0.0f;
+    bool cache_resident = false;
+    bool selected_for_execution = false;
+    size_t layer_resident_experts = 0;
+    int32_t layer_expert_count = 0;
+    int32_t cache_group_slots = 0;
+    size_t logical_expert_bytes = 0;
+    int32_t dynamic_required_k = 0;
+    int32_t dynamic_selected_k = 0;
+    int32_t dynamic_cache_extra_k = 0;
+    uint64_t monotonic_ns = 0;
+};
+
+struct expert_upload_row {
+    int64_t token = 0;
+    int32_t expert = -1;
+    int32_t router_rank = -1;
+    float router_weight = 0.0f;
+    bool cache_resident = false;
+    bool selected_for_execution = false;
+    bool will_upload = false;
+    llama_moe_cache_io_profile::source_residency source;
+    size_t expert_bytes = 0;
+};
+
+class state {
+public:
+    void initialize(size_t n_layers, size_t route_rank_count);
+    void configure_from_env(size_t n_layers);
+
+    bool route_enabled() const;
+    bool upload_enabled() const;
+    bool upload_enabled_for_layer(int32_t layer) const;
+    bool debug_request_matches(int32_t layer, int32_t expert_count, const std::vector<int32_t> & routed_experts) const;
+    int32_t debug_expert() const;
+    void record_debug_request(bool cache_hit, size_t uploaded_bytes);
+    void log_debug_summary() const;
+
+    uint64_t begin_route_batch(size_t resident_experts);
+    void write_route_row(const route_row & row);
+    void write_expert_upload_rows(
+            int32_t layer,
+            uint64_t batch,
+            const std::vector<expert_upload_row> & rows,
+            uint64_t start_ns,
+            uint64_t end_ns,
+            uint64_t wall_us,
+            const ggml_backend_tensor_set_batch_stats * batch_stats,
+            size_t upload_bytes);
+    void log_route_summary(size_t evictions);
+
+private:
+    struct rank_stats {
+        size_t routes = 0;
+        size_t resident = 0;
+        double weight = 0.0;
+    };
+
+    std::ofstream route_trace;
+    bool route_trace_timestamp_enabled = false;
+    size_t route_trace_rows = 0;
+    size_t route_trace_max_rows = 1000000;
+    size_t route_trace_occupancy_sum = 0;
+    size_t route_trace_occupancy_samples = 0;
+    bool route_trace_truncated = false;
+    std::ofstream expert_upload_trace;
+    int32_t expert_upload_trace_layer = -1;
+    std::vector<std::vector<rank_stats>> route_rank_stats_by_layer;
+    int32_t debug_layer = -1;
+    int32_t debug_expert_id = -1;
+    size_t debug_request_batches = 0;
+    size_t debug_cache_hit_batches = 0;
+    size_t debug_cache_miss_batches = 0;
+    size_t debug_uploaded_bytes = 0;
+};
+
+} // namespace llama_moe_cache_trace
