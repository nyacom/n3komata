+static bool n3komata_profile_tensor_layer(const char * name, const char * prefix, int & layer) {
+    const size_t prefix_size = std::strlen(prefix);
+    if (std::strncmp(name, prefix, prefix_size) != 0) {
+        return false;
+    }
+    char * end = nullptr;
+    const long parsed = std::strtol(name + prefix_size, &end, 10);
+    if (end == name + prefix_size || *end != '\0' || parsed < 0 || parsed > std::numeric_limits<int>::max()) {
+        return false;
+    }
+    layer = (int) parsed;
+    return true;
+}
+
+static float n3komata_profile_value(const uint8_t * data, ggml_type type, size_t offset) {
+    switch (type) {
+        case GGML_TYPE_F32: {
+            float value;
+            std::memcpy(&value, data + offset, sizeof(value));
+            return value;
+        }
+        case GGML_TYPE_F16: {
+            ggml_fp16_t value;
+            std::memcpy(&value, data + offset, sizeof(value));
+            return ggml_fp16_to_fp32(value);
+        }
+        case GGML_TYPE_BF16: {
+            ggml_bf16_t value;
+            std::memcpy(&value, data + offset, sizeof(value));
+            return ggml_bf16_to_fp32(value);
+        }
+        default:
+            throw std::runtime_error(std::string("unsupported activation profile tensor type ") + ggml_type_name(type));
+    }
+}
