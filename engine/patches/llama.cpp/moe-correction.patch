+static void n3komata_load_expert_skip(llama_model_qwen4exp & model) {
+    const char * policy_value = std::getenv("N3KOMATA_MOE_SKIP_POLICY");
+    const char * k_value = std::getenv("N3KOMATA_MOE_SKIP_K");
+    const char * dynamic_value = std::getenv("N3KOMATA_MOE_DYNAMIC_K");
+    const char * protected_path = std::getenv("N3KOMATA_MOE_PROTECTED_EXPERTS_FILE");
+    const bool has_policy = policy_value != nullptr && *policy_value != '\0';
+    const bool has_k = k_value != nullptr && *k_value != '\0';
+    const bool has_dynamic = dynamic_value != nullptr && *dynamic_value != '\0';
+    const bool has_protected = protected_path != nullptr && *protected_path != '\0';
+    const bool skip_zero = n3komata_env_bool("N3KOMATA_MOE_DYNAMIC_K_SKIP_ZERO", false);
+    const bool device_dynamic = n3komata_env_bool("N3KOMATA_MOE_DYNAMIC_K_DEVICE", false);
+    if (skip_zero && !has_dynamic) {
+        throw std::runtime_error("N3KOMATA_MOE_DYNAMIC_K_SKIP_ZERO requires N3KOMATA_MOE_DYNAMIC_K=router or cache");
+    }
+    if (device_dynamic && !has_dynamic) {
+        throw std::runtime_error("N3KOMATA_MOE_DYNAMIC_K_DEVICE requires N3KOMATA_MOE_DYNAMIC_K=router");
+    }
+    if (has_dynamic) {
+        if (has_policy || has_k || has_protected) {
+            throw std::runtime_error("N3KOMATA_MOE_DYNAMIC_K cannot be combined with N3KOMATA_MOE_SKIP_K, N3KOMATA_MOE_SKIP_POLICY, or N3KOMATA_MOE_PROTECTED_EXPERTS_FILE");
+        }
+        int32_t mode = 0;
+        if (std::strcmp(dynamic_value, "router") == 0) {
+            mode = 1;
+        } else if (std::strcmp(dynamic_value, "cache") == 0) {
+            mode = 2;
+        } else {
+            throw std::runtime_error(format("N3KOMATA_MOE_DYNAMIC_K must be 'router' or 'cache', got %s", dynamic_value));
+        }
+        if (device_dynamic && mode != 1) {
+            throw std::runtime_error("N3KOMATA_MOE_DYNAMIC_K_DEVICE currently supports N3KOMATA_MOE_DYNAMIC_K=router only");
+        }
+        if (device_dynamic && std::getenv("N3KOMATA_MOE_FALLBACK_CUTOFF_US") != nullptr) {
+            throw std::runtime_error("N3KOMATA_MOE_DYNAMIC_K_DEVICE cannot be combined with N3KOMATA_MOE_FALLBACK_CUTOFF_US in this prototype");
+        }
+        const int k_min = n3komata_env_integer("N3KOMATA_MOE_DYNAMIC_K_MIN", 3, 1, model.hparams.n_expert_used_max());
+        const int k_max = n3komata_env_integer("N3KOMATA_MOE_DYNAMIC_K_MAX", 8, k_min, model.hparams.n_expert_used_max());
+        const float mass = n3komata_env_fraction("N3KOMATA_MOE_DYNAMIC_K_MASS", 0.80f);
+        for (uint32_t il = 0; il < model.hparams.n_layer(); ++il) {
+            const uint32_t original_k = model.hparams.n_expert_used(il);
+            if ((uint32_t) k_max > original_k) {
+                throw std::runtime_error(format("dynamic keep-k max=%d exceeds layer %u top-k=%u", k_max, il, original_k));
+            }
+            llama_layer & layer = model.layers[il];
+            layer.ffn_expert_skip_k = k_max;
+            layer.ffn_expert_dynamic_k_mode = mode;
+            layer.ffn_expert_dynamic_k_min = k_min;
+            layer.ffn_expert_dynamic_k_max = k_max;
+            layer.ffn_expert_dynamic_k_mass = mass;
+            layer.ffn_expert_dynamic_k_skip_zero = skip_zero;
+            layer.ffn_expert_dynamic_k_device = device_dynamic;
+        }
+        LLAMA_LOG_INFO("n3komata expert dynamic-k: mode=%s min=%d max=%d cumulative-router-mass=%.3f skip-zero-slots=%s device-selection=%s; graph uses max-k slots\n",
+            dynamic_value, k_min, k_max, mass, skip_zero ? "true" : "false", device_dynamic ? "true" : "false");
+        return;
+    }
+    if (!has_policy && !has_k) {
+        if (has_protected) {
+            throw std::runtime_error("N3KOMATA_MOE_PROTECTED_EXPERTS_FILE requires N3KOMATA_MOE_SKIP_K");
+        }
+        return;
+    }
+    if (has_policy && has_k) {
+        throw std::runtime_error("set either N3KOMATA_MOE_SKIP_POLICY or N3KOMATA_MOE_SKIP_K, not both");
+    }
+    if (has_policy && has_protected) {
+        throw std::runtime_error("N3KOMATA_MOE_PROTECTED_EXPERTS_FILE currently requires fixed N3KOMATA_MOE_SKIP_K");
+    }
+
+    const std::vector<std::vector<int32_t>> protected_ids = has_protected
+            ? n3komata_load_protected_experts(model, protected_path)
+            : std::vector<std::vector<int32_t>>(model.hparams.n_layer());
+
+    std::vector<int32_t> keep_k(model.hparams.n_layer(), -1);
+    if (has_policy) {
+        // Format: comma-separated layer:keep-k pairs, e.g. "0:8,9:6,19:10".
+        const char * p = policy_value;
+        while (*p != '\0') {
+            char * layer_end = nullptr;
+            const long layer_id = std::strtol(p, &layer_end, 10);
+            if (layer_end == p || *layer_end != ':' || layer_id < 0 || layer_id >= model.hparams.n_layer()) {
+                throw std::runtime_error(format("invalid N3KOMATA_MOE_SKIP_POLICY value: %s", policy_value));
+            }
+            const char * k_start = layer_end + 1;
+            char * k_end = nullptr;
+            const long parsed_k = std::strtol(k_start, &k_end, 10);
+            if (k_end == k_start || parsed_k <= 0 || parsed_k > model.hparams.n_expert_used_max() ||
+                    (*k_end != '\0' && *k_end != ',') || keep_k[layer_id] != -1) {
+                throw std::runtime_error(format("invalid N3KOMATA_MOE_SKIP_POLICY value: %s", policy_value));
+            }
+            keep_k[layer_id] = (int32_t) parsed_k;
+            if (*k_end == '\0') {
+                break;
+            }
+            p = k_end + 1;
+            if (*p == '\0') {
+                throw std::runtime_error(format("invalid N3KOMATA_MOE_SKIP_POLICY value: %s", policy_value));
+            }
+        }
+    } else {
+        char * end = nullptr;
+        const long parsed_k = std::strtol(k_value, &end, 10);
+        if (end == k_value || *end != '\0' || parsed_k <= 0 || parsed_k > model.hparams.n_expert_used_max()) {
+            throw std::runtime_error(format("N3KOMATA_MOE_SKIP_K must be in [1, %u], got %s",
+                                            model.hparams.n_expert_used_max(), k_value));
+        }
+        if (parsed_k == model.hparams.n_expert_used_max()) {
+            LLAMA_LOG_INFO("n3komata expert skip: top-%ld equals the model top-k; no routes will be skipped\n", parsed_k);
+            return;
+        }
+
+        const char * layers_value = std::getenv("N3KOMATA_MOE_SKIP_LAYERS");
+        if (layers_value == nullptr || *layers_value == '\0') {
+            throw std::runtime_error("N3KOMATA_MOE_SKIP_LAYERS must be set when N3KOMATA_MOE_SKIP_K is set (use 'all' or comma-separated layer ids)");
+        }
+
+        std::vector<bool> selected(model.hparams.n_layer(), false);
+        if (std::strcmp(layers_value, "all") == 0) {
+            std::fill(selected.begin(), selected.end(), true);
+        } else {
+            const char * p = layers_value;
+            while (*p != '\0') {
+                char * layer_end = nullptr;
+                const long layer_id = std::strtol(p, &layer_end, 10);
+                if (layer_end == p || layer_id < 0 || layer_id >= model.hparams.n_layer() ||
+                        (*layer_end != '\0' && *layer_end != ',')) {
+                    throw std::runtime_error(format("invalid N3KOMATA_MOE_SKIP_LAYERS value: %s", layers_value));
+                }
+                selected[layer_id] = true;
+                if (*layer_end == '\0') {
+                    break;
+                }
+                p = layer_end + 1;
+                if (*p == '\0') {
+                    throw std::runtime_error(format("invalid N3KOMATA_MOE_SKIP_LAYERS value: %s", layers_value));
+                }
+            }
+        }
+        for (uint32_t il = 0; il < model.hparams.n_layer(); ++il) {
+            if (selected[il]) {
+                keep_k[il] = (int32_t) parsed_k;
+            }
+        }
+    }
+
+    std::string selected_text;
+    std::string protected_text;
+    for (uint32_t il = 0; il < model.hparams.n_layer(); ++il) {
+        if (keep_k[il] < 0) {
+            continue;
+        }
+        const uint32_t original_k = model.hparams.n_expert_used(il);
+        if ((uint32_t) keep_k[il] > original_k) {
+            throw std::runtime_error(format("expert skip keep-k=%d exceeds layer %u top-k=%u", keep_k[il], il, original_k));
+        }
+        if ((uint32_t) keep_k[il] < original_k) {
+            llama_layer & layer = model.layers[il];
+            layer.ffn_expert_skip_k = keep_k[il];
+            selected_text += selected_text.empty() ? format("%u:%d", il, keep_k[il]) : format(",%u:%d", il, keep_k[il]);
+            if (!protected_ids[il].empty()) {
+                layer.ffn_expert_dynamic_k_mode = 3;
+                layer.ffn_expert_dynamic_k_min = keep_k[il];
+                layer.ffn_expert_dynamic_k_max = keep_k[il];
+                layer.ffn_expert_dynamic_k_mass = 0.0f;
+                layer.ffn_expert_protected_ids = protected_ids[il];
+                for (int32_t expert : protected_ids[il]) {
+                    protected_text += protected_text.empty()
+                            ? format("%u:%d", il, expert)
+                            : format(",%u:%d", il, expert);
+                }
+            }
+        }
+    }
+    if (has_protected && protected_text.empty()) {
+        throw std::runtime_error("N3KOMATA_MOE_PROTECTED_EXPERTS_FILE contains no experts for layers selected by N3KOMATA_MOE_SKIP_LAYERS");
+    }
+    if (selected_text.empty()) {
+        LLAMA_LOG_INFO("n3komata expert skip: configured policy keeps every layer's full routed top-k; no routes will be skipped\n");
+        return;
+    }
+    LLAMA_LOG_INFO("n3komata expert skip: original router top-k preserved; keep configured top-k without weight renormalization in layers %s\n",
+            selected_text.c_str());
+    if (!protected_text.empty()) {
+        LLAMA_LOG_INFO("n3komata protected experts: preserve listed experts inside fixed keep-k when present in router top-k; layers %s\n",
+                protected_text.c_str());
+    }
+}
