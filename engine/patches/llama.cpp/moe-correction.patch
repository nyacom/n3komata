+static void ggml_vk_profile_source_residency(
+        const ggml_backend_tensor_set_batch_item * items,
+        size_t n_items,
+        ggml_backend_tensor_set_batch_stats * stats) {
+#if defined(__linux__)
+    const char * enabled = std::getenv("N3KOMATA_MOE_IO_MINCORE");
+    if (stats == nullptr || enabled == nullptr || std::strcmp(enabled, "1") != 0) {
+        return;
+    }
+    const long page_size_long = sysconf(_SC_PAGESIZE);
+    if (page_size_long <= 0) {
+        return;
+    }
+    const uintptr_t page_size = (uintptr_t) page_size_long;
+    std::vector<unsigned char> residency;
+    const auto start = std::chrono::steady_clock::now();
+    for (size_t i = 0; i < n_items; ++i) {
+        const auto & item = items[i];
+        if (item.data == nullptr || item.size == 0) {
+            continue;
+        }
+        const uintptr_t begin = (uintptr_t) item.data;
+        const uintptr_t raw_end = begin + item.size;
+        if (raw_end < begin || raw_end > UINTPTR_MAX - (page_size - 1)) {
+            continue;
+        }
+        const uintptr_t first = begin / page_size * page_size;
+        const uintptr_t last = (raw_end + page_size - 1) / page_size * page_size;
+        const size_t n_pages = (last - first) / page_size;
+        if (n_pages == 0) {
+            continue;
+        }
+        residency.resize(n_pages);
+        if (mincore((void *) first, last - first, residency.data()) != 0) {
+            continue;
+        }
+        stats->source_pages_checked += n_pages;
+        for (unsigned char state : residency) {
+            stats->source_pages_resident += (state & 1) != 0;
+        }
+    }
+    stats->source_mincore_us += (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - start).count();
+#else
+    GGML_UNUSED(items);
+    GGML_UNUSED(n_items);
+    GGML_UNUSED(stats);
+#endif
+}
+
+static void ggml_vk_madvise_source_cold(
+        const ggml_backend_tensor_set_batch_item * items,
+        size_t n_items,
+        ggml_backend_tensor_set_batch_stats * stats) {
+#if defined(__linux__) && defined(MADV_COLD)
+    const char * enabled = std::getenv("N3KOMATA_MOE_MMAP_COLD_ON_GPU_UPLOAD");
+    if (enabled == nullptr || std::strcmp(enabled, "1") != 0) {
+        return;
+    }
+    const long page_size_long = sysconf(_SC_PAGESIZE);
+    if (page_size_long <= 0) {
+        return;
+    }
+    const uintptr_t page_size = (uintptr_t) page_size_long;
+    const auto start = std::chrono::steady_clock::now();
+    for (size_t i = 0; i < n_items; ++i) {
+        const auto & item = items[i];
+        if (item.data == nullptr || item.size == 0) {
+            continue;
+        }
+        const uintptr_t begin = (uintptr_t) item.data;
+        const uintptr_t raw_end = begin + item.size;
+        if (raw_end < begin || raw_end > UINTPTR_MAX - (page_size - 1)) {
+            continue;
+        }
+        const uintptr_t first = begin / page_size * page_size;
+        const uintptr_t last = (raw_end + page_size - 1) / page_size * page_size;
+        if (last <= first) {
+            continue;
+        }
+        if (stats != nullptr) {
+            stats->source_madvise_cold_ranges++;
+            stats->source_madvise_cold_bytes += last - first;
+        }
+        if (madvise((void *) first, last - first, MADV_COLD) != 0) {
+            if (stats != nullptr) {
+                stats->source_madvise_cold_failures++;
+            }
+        }
+    }
+    if (stats != nullptr) {
+        stats->source_madvise_cold_us += (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - start).count();
+    }
+#else
+    GGML_UNUSED(items);
+    GGML_UNUSED(n_items);
+    GGML_UNUSED(stats);
+#endif
+}
