+    void wait_transition_read(int32_t current_layer) {
+        if (!transition_async_read_enabled) {
+            return;
+        }
+        std::unique_lock<std::mutex> lock(transition_read_mutex);
+        if (transition_read_submitted == transition_read_consumed) {
+            return;
+        }
+        const auto wait_start = std::chrono::steady_clock::now();
+        const uint64_t job_id = transition_read_submitted;
+        transition_read_complete.wait(lock, [&]() { return transition_read_completed >= job_id; });
+        const uint64_t wait_us = llama_moe_elapsed_us(wait_start);
+        const int32_t target_layer = transition_read_layer;
+        if (target_layer >= 0 && target_layer < (int32_t) transition_prefetch_stats_by_layer.size()) {
+            transition_prefetch_stats & stats = transition_prefetch_stats_by_layer[target_layer];
+            stats.prefetch_us += transition_read_hint_us;
+            stats.async_hint_us += transition_read_hint_us;
+            stats.async_touch_us += transition_read_touch_us;
+            stats.async_wait_us += wait_us;
+            stats.async_worker_jobs++;
+            stats.async_worker_active_us += transition_read_duration_us;
+            const auto lead_us = std::chrono::duration_cast<std::chrono::microseconds>(
+                    wait_start - transition_read_submitted_at).count();
+            const auto queue_us = std::chrono::duration_cast<std::chrono::microseconds>(
+                    transition_read_started_at - transition_read_submitted_at).count();
+            stats.async_worker_lead_us += lead_us > 0 ? (uint64_t) lead_us : 0;
+            stats.async_worker_queue_us += queue_us > 0 ? (uint64_t) queue_us : 0;
+            if (wait_start > transition_read_completed_at) {
+                stats.async_worker_ready_ahead_us += (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+                        wait_start - transition_read_completed_at).count();
+            }
+            const auto overlap_start = std::max(transition_read_submitted_at, transition_read_started_at);
+            const auto overlap_end = std::min(wait_start, transition_read_completed_at);
+            if (overlap_end > overlap_start) {
+                stats.async_worker_overlap_us += (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+                        overlap_end - overlap_start).count();
+            }
+            stats.async_read_faults += transition_read_faults;
+            stats.async_read_minor_faults += transition_read_minor_faults;
+            stats.async_read_pages += transition_read_pages;
+            stats.async_read_bytes += transition_read_bytes;
+        }
+        if (io_profile.enabled && current_layer >= 0 && current_layer < (int32_t) io_profile.io_stats_by_layer.size()) {
+            io_profile.io_stats_by_layer[current_layer].async_read_wait_us += wait_us;
+            const ggml_tensor * route_ids = route_ids_by_layer[current_layer];
+            if (route_ids != nullptr) {
+                const bool is_decode = route_ids->ne[1] == 1;
+                io_phase_stats & phase_stats = is_decode
+                    ? io_profile.io_decode_stats_by_layer[current_layer]
+                    : io_profile.io_prefill_stats_by_layer[current_layer];
+                phase_stats.async_read_jobs++;
+                phase_stats.async_read_wait_us += wait_us;
+                phase_stats.async_read_worker_active_us += transition_read_duration_us;
+                const auto lead_us = std::chrono::duration_cast<std::chrono::microseconds>(
+                        wait_start - transition_read_submitted_at).count();
+                const auto queue_us = std::chrono::duration_cast<std::chrono::microseconds>(
+                        transition_read_started_at - transition_read_submitted_at).count();
+                const auto ready_ahead_us = wait_start > transition_read_completed_at
+                    ? std::chrono::duration_cast<std::chrono::microseconds>(wait_start - transition_read_completed_at).count()
+                    : 0;
+                const auto overlap_start = std::max(transition_read_submitted_at, transition_read_started_at);
+                const auto overlap_end = std::min(wait_start, transition_read_completed_at);
+                const auto overlap_us = overlap_end > overlap_start
+                    ? std::chrono::duration_cast<std::chrono::microseconds>(overlap_end - overlap_start).count()
+                    : 0;
+                phase_stats.async_read_worker_lead_us += lead_us > 0 ? (uint64_t) lead_us : 0;
+                phase_stats.async_read_worker_queue_us += queue_us > 0 ? (uint64_t) queue_us : 0;
+                phase_stats.async_read_worker_overlap_us += overlap_us > 0 ? (uint64_t) overlap_us : 0;
+                phase_stats.async_read_worker_ready_ahead_us += ready_ahead_us > 0 ? (uint64_t) ready_ahead_us : 0;
+            }
+        }
+        transition_read_consumed = job_id;
+    }
+
+    void stop_transition_read_worker() {
+        if (!transition_read_thread.joinable()) {
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(transition_read_mutex);
+            transition_read_stop = true;
+        }
+        transition_read_request.notify_one();
+        transition_read_thread.join();
+    }
