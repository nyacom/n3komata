+    std::ofstream submit_out(ctx->kernel_gap_output_path + ".submits.csv");
+    if (submit_out) {
+        submit_out << "submission_id,queue_family,cpu_submit_start_raw_ns,cpu_submit_end_raw_ns,cpu_submit_us\n";
+        for (const auto & event : ctx->kernel_gap_submit_events) {
