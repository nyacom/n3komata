+                       << event.cpu_submit_start_ns << ',' << event.cpu_submit_end_ns << ','
+                       << std::fixed << std::setprecision(3)
+                       << (double) (event.cpu_submit_end_ns - event.cpu_submit_start_ns) / 1000.0 << '\n';
+        }
+    }
+    std::ofstream host_out(ctx->kernel_gap_output_path + ".host-events.csv");
+    if (host_out) {
+        host_out << "event,start_monotonic_raw_ns,end_monotonic_raw_ns,duration_us\n";
+        for (const auto & event : ctx->kernel_gap_host_events) {
+            host_out << event.event_name << ',' << event.host_start_ns << ',' << event.host_end_ns << ','
+                     << std::fixed << std::setprecision(3)
+                     << (double) (event.host_end_ns - event.host_start_ns) / 1000.0 << '\n';
+        }
+    }
+    std::ofstream calibration_out(ctx->kernel_gap_output_path + ".calibrations.csv");
+    if (calibration_out) {
+        calibration_out << "device_ticks,host_monotonic_raw_ns,max_deviation_ns,timestamp_period_ns\n";
+        for (const auto & point : calibrations) {
+            calibration_out << point.device_ticks << ',' << point.host_raw_ns << ',' << point.max_deviation_ns << ','
+                            << std::fixed << std::setprecision(3) << ctx->kernel_gap_timestamp_period_ns << '\n';
+        }
+    }
+    GGML_LOG_INFO("n3komata_vk_kernel_gap: samples=%zu dropped=%" PRIu64 " calibrations=%zu calibration=%d max_deviation_ns=%" PRIu64 " output=%s\n",
+                   samples.size(), ctx->kernel_gap_dropped_samples, calibrations.size(), ctx->kernel_gap_calibration_valid,
+                   ctx->kernel_gap_calibration_max_deviation_ns, ctx->kernel_gap_output_path.c_str());
+}
