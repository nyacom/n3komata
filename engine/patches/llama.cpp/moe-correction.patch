diff --git a/src/llama-moe-cache-trace.cpp b/src/llama-moe-cache-trace.cpp
new file mode 100644
index 000000000..0b43cc870
--- /dev/null
+++ b/src/llama-moe-cache-trace.cpp
@@ -0,0 +1,189 @@
+#include "llama-moe-cache-trace.h"
+
+#include "llama-impl.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdlib>
+#include <iomanip>
+#include <stdexcept>
+
+namespace llama_moe_cache_trace {
+
+void state::initialize(size_t n_layers, size_t route_rank_count) {
+    route_rank_stats_by_layer.resize(n_layers);
+    for (auto & layer_stats : route_rank_stats_by_layer) {
+        layer_stats.resize(route_rank_count);
+    }
+}
+
+void state::configure_from_env(size_t n_layers) {
+    if (const char * value = std::getenv("N3KOMATA_MOE_CACHE_TRACE_LAYER")) {
+        debug_layer = std::atoi(value);
+    }
+    if (const char * value = std::getenv("N3KOMATA_MOE_CACHE_TRACE_EXPERT")) {
+        debug_expert_id = std::atoi(value);
+    }
+
+    if (const char * path = std::getenv("N3KOMATA_MOE_ROUTE_TRACE")) {
+        route_trace.open(path, std::ios::out | std::ios::trunc);
+        if (!route_trace) {
+            throw std::runtime_error(format("failed to open N3KOMATA_MOE_ROUTE_TRACE: %s", path));
+        }
+        if (const char * timestamp = std::getenv("N3KOMATA_MOE_ROUTE_TRACE_TIMESTAMP")) {
+            route_trace_timestamp_enabled = std::atoi(timestamp) != 0;
+        }
+        route_trace << "layer,batch,token,rank,expert_id,router_weight,cache_resident,selected_for_execution,layer_resident_experts,layer_expert_count,cache_group_slots,logical_expert_bytes,dynamic_required_k,dynamic_selected_k,dynamic_cache_extra_k";
+        if (route_trace_timestamp_enabled) {
+            route_trace << ",monotonic_ns";
+        }
+        route_trace << '\n';
+    }
+
+    if (const char * path = std::getenv("N3KOMATA_MOE_EXPERT_UPLOAD_TRACE")) {
+        if (path[0] != '\0') {
+            const char * layer_value = std::getenv("N3KOMATA_MOE_EXPERT_UPLOAD_TRACE_LAYER");
+            if (layer_value == nullptr || layer_value[0] == '\0') {
+                throw std::runtime_error("N3KOMATA_MOE_EXPERT_UPLOAD_TRACE_LAYER is required with N3KOMATA_MOE_EXPERT_UPLOAD_TRACE");
+            }
+            char * end = nullptr;
+            const long parsed_layer = std::strtol(layer_value, &end, 10);
+            if (end == layer_value || *end != '\0' || parsed_layer < 0 || parsed_layer >= (long) n_layers) {
+                throw std::runtime_error(format("invalid N3KOMATA_MOE_EXPERT_UPLOAD_TRACE_LAYER='%s'", layer_value));
+            }
+            expert_upload_trace_layer = (int32_t) parsed_layer;
+            expert_upload_trace.open(path, std::ios::out | std::ios::trunc);
+            if (!expert_upload_trace) {
+                throw std::runtime_error(format("failed to open N3KOMATA_MOE_EXPERT_UPLOAD_TRACE: %s", path));
+            }
+            expert_upload_trace << "layer,batch,token,expert_id,router_rank,router_weight,cache_resident,selected_for_execution,will_upload,source_pages_checked,source_pages_resident,source_mincore_us,expert_bytes,upload_batch_start_monotonic_ns,upload_batch_end_monotonic_ns,upload_wall_us,upload_source_copy_us,upload_source_copy_thread_cpu_us,upload_sync_wait_us,upload_gpu_copy_ns,batch_upload_bytes,batch_stats_valid\n";
+            LLAMA_LOG_INFO("n3komata_moe_expert_upload_trace: layer=%d path=%s\n", expert_upload_trace_layer, path);
+        }
+    }
+}
+
+bool state::route_enabled() const {
+    return route_trace.is_open();
+}
+
+bool state::upload_enabled() const {
+    return expert_upload_trace.is_open();
+}
+
+bool state::upload_enabled_for_layer(int32_t layer) const {
+    return expert_upload_trace.is_open() && layer == expert_upload_trace_layer;
+}
+
+bool state::debug_request_matches(
+        int32_t layer, int32_t expert_count, const std::vector<int32_t> & routed_experts) const {
+    return layer == debug_layer && debug_expert_id >= 0 && debug_expert_id < expert_count &&
+            std::find(routed_experts.begin(), routed_experts.end(), debug_expert_id) != routed_experts.end();
+}
+
+int32_t state::debug_expert() const {
+    return debug_expert_id;
+}
+
+void state::record_debug_request(bool cache_hit, size_t uploaded_bytes) {
+    debug_request_batches++;
+    if (cache_hit) {
+        debug_cache_hit_batches++;
+    } else {
+        debug_cache_miss_batches++;
+        debug_uploaded_bytes += uploaded_bytes;
+    }
+}
+
+void state::log_debug_summary() const {
+    if (debug_layer < 0 || debug_expert_id < 0) {
+        return;
+    }
+    LLAMA_LOG_INFO("n3komata_moe_trace: layer=%d expert=%d request_batches=%zu cache_hit_batches=%zu cache_miss_batches=%zu uploaded=%.2f MiB\n",
+            debug_layer, debug_expert_id, debug_request_batches,
+            debug_cache_hit_batches, debug_cache_miss_batches, debug_uploaded_bytes/1024.0/1024.0);
+}
+
+uint64_t state::begin_route_batch(size_t resident_experts) {
+    route_trace_occupancy_sum += resident_experts;
+    route_trace_occupancy_samples++;
+    if (!route_trace_timestamp_enabled) {
+        return 0;
+    }
+    return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+void state::write_route_row(const route_row & row) {
+    if (row.rank >= route_rank_stats_by_layer[row.layer].size()) {
+        route_rank_stats_by_layer[row.layer].resize(row.rank + 1);
+    }
+    rank_stats & stats = route_rank_stats_by_layer[row.layer][row.rank];
+    stats.routes++;
+    stats.resident += row.cache_resident;
+    stats.weight += row.router_weight;
+
+    if (route_trace_rows < route_trace_max_rows) {
+        route_trace << row.layer << ',' << row.batch << ',' << row.token << ',' << row.rank << ',' << row.expert << ','
+                    << std::setprecision(9) << row.router_weight << ',' << row.cache_resident << ','
+                    << row.selected_for_execution << ',' << row.layer_resident_experts << ',' << row.layer_expert_count << ','
+                    << row.cache_group_slots << ',' << row.logical_expert_bytes << ','
+                    << row.dynamic_required_k << ',' << row.dynamic_selected_k << ',' << row.dynamic_cache_extra_k;
+        if (route_trace_timestamp_enabled) {
+            route_trace << ',' << row.monotonic_ns;
+        }
+        route_trace << '\n';
+        route_trace_rows++;
+    } else {
+        route_trace_truncated = true;
+    }
+}
+
+void state::write_expert_upload_rows(
+        int32_t layer,
+        uint64_t batch,
+        const std::vector<expert_upload_row> & rows,
+        uint64_t start_ns,
+        uint64_t end_ns,
+        uint64_t wall_us,
+        const ggml_backend_tensor_set_batch_stats * batch_stats,
+        size_t upload_bytes) {
+    for (const expert_upload_row & row : rows) {
+        expert_upload_trace << layer << ',' << batch << ',' << row.token << ',' << row.expert << ','
+            << row.router_rank << ',' << std::setprecision(9) << row.router_weight << ',' << row.cache_resident << ','
+            << row.selected_for_execution << ',' << row.will_upload << ',' << row.source.pages_checked << ','
+            << row.source.pages_resident << ',' << row.source.mincore_us << ',' << row.expert_bytes << ','
+            << start_ns << ',' << end_ns << ',' << wall_us << ','
+            << (batch_stats != nullptr ? batch_stats->source_copy_us : 0) << ','
+            << (batch_stats != nullptr ? batch_stats->source_copy_thread_cpu_us : 0) << ','
+            << (batch_stats != nullptr ? batch_stats->sync_after_wait_us : 0) << ','
+            << (batch_stats != nullptr ? batch_stats->gpu_copy_ns : 0) << ','
+            << upload_bytes << ',' << (batch_stats != nullptr) << '\n';
+    }
+}
+
+void state::log_route_summary(size_t evictions) {
+    route_trace.flush();
+    size_t routes[32] = {};
+    size_t resident[32] = {};
+    double weights[32] = {};
+    for (const auto & layer_stats : route_rank_stats_by_layer) {
+        for (size_t rank = 0; rank < layer_stats.size() && rank < 32; ++rank) {
+            routes[rank] += layer_stats[rank].routes;
+            resident[rank] += layer_stats[rank].resident;
+            weights[rank] += layer_stats[rank].weight;
+        }
+    }
+    for (size_t rank = 0; rank < 32 && routes[rank] > 0; ++rank) {
+        LLAMA_LOG_INFO("n3komata_moe_rank: rank=%zu routes=%zu cache_resident=%zu hit_rate=%.2f%% mean_weight=%.6f\n",
+            rank + 1, routes[rank], resident[rank], 100.0*resident[rank]/routes[rank], weights[rank]/routes[rank]);
+    }
+    if (route_trace_occupancy_samples > 0) {
+        LLAMA_LOG_INFO("n3komata_moe_occupancy: samples=%zu mean_layer_resident_experts=%.2f trace_rows=%zu\n",
+            route_trace_occupancy_samples,
+            (double) route_trace_occupancy_sum/route_trace_occupancy_samples, route_trace_rows);
+    }
+    LLAMA_LOG_INFO("n3komata_moe_evictions: count=%zu trace_truncated=%s\n",
+        evictions, route_trace_truncated ? "true" : "false");
+}
+
+} // namespace llama_moe_cache_trace
