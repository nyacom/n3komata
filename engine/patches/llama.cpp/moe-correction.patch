+source_residency llama_moe_profile_expert_residency(
+        const std::vector<ggml_tensor *> & weights,
+        int32_t expert) {
+    source_residency result;
+#if defined(__linux__)
+    static const long page_size_long = sysconf(_SC_PAGESIZE);
+    if (page_size_long <= 0 || expert < 0) {
+        return result;
+    }
+    const uintptr_t page_size = (uintptr_t) page_size_long;
+    std::vector<unsigned char> residency;
+    const auto start = std::chrono::steady_clock::now();
+    for (const ggml_tensor * weight : weights) {
+        if (weight == nullptr || weight->data == nullptr || ggml_n_dims(weight) < 3 ||
+                expert >= weight->ne[2] || weight->nb[2] == 0) {
+            continue;
+        }
+        const uintptr_t begin = (uintptr_t) weight->data + (size_t) expert * weight->nb[2];
+        const uintptr_t raw_end = begin + weight->nb[2];
+        if (raw_end < begin || raw_end > UINTPTR_MAX - (page_size - 1)) {
+            continue;
+        }
+        const uintptr_t first = begin / page_size * page_size;
+        const uintptr_t last = (raw_end + page_size - 1) / page_size * page_size;
+        const size_t n_pages = (last - first) / page_size;
+        if (n_pages == 0) {
+            continue;
+        }
+        residency.resize(n_pages);
+        if (mincore((void *) first, last - first, residency.data()) != 0) {
+            continue;
+        }
+        result.pages_checked += n_pages;
+        for (unsigned char state : residency) {
+            result.pages_resident += (state & 1) != 0;
+        }
+    }
+    result.mincore_us = (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - start).count();
+#else
+    GGML_UNUSED(weights);
+    GGML_UNUSED(expert);
+#endif
+    return result;
+}
