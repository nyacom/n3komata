+        }
+        if (st.direct_read_requests > 0) {
+            LLAMA_LOG_INFO("n3komata_moe_source_read: layer=%zu mode=odirect qd=%zu requests=%" PRIu64
+                    " payload_mib=%.2f aligned_io_mib=%.2f parallel_wall_ms=%.3f worker_sum_ms=%.3f\n",
+                    il, source_read_qd, st.direct_read_requests,
+                    st.direct_read_payload_bytes/1024.0/1024.0,
+                    st.direct_read_io_bytes/1024.0/1024.0,
+                    st.direct_read_wall_us/1000.0, st.direct_read_worker_us/1000.0);
+        }
+    LLAMA_LOG_INFO("n3komata_moe_io: layer=%zu callbacks=%" PRIu64 " callback_ms=%.3f route_sync_ms=%.3f plan_ms=%.3f prefetch_ms=%.3f prefetch_mib=%.2f upload_call_sum_ms=%.3f upload_wall_ms=%.3f upload_calls=%" PRIu64 " upload_batches=%" PRIu64 " upload_mib=%.2f max_upload_ms=%.3f upload_major_faults=%" PRIu64 " upload_minor_faults=%" PRIu64 " prefetch=%d callback_process_read_bytes=%" PRIu64 " callback_device_read_bytes=%" PRIu64 " callback_major_faults=%" PRIu64 " callback_minor_faults=%" PRIu64 " upload_process_read_bytes=%" PRIu64 " upload_device_read_bytes=%" PRIu64 " async_read_wait_ms=%.3f upload_source_copy_ms=%.3f source_copy_thread_cpu_ms=%.3f source_copy_major_faults=%" PRIu64 " source_copy_minor_faults=%" PRIu64 " source_mincore_ms=%.3f source_pages_checked=%" PRIu64 " source_pages_resident=%" PRIu64 " upload_staging_setup_ms=%.3f upload_sync_before_ms=%.3f upload_command_record_ms=%.3f upload_sync_after_ms=%.3f upload_sync_submit_ms=%.3f upload_sync_wait_ms=%.3f upload_sync_host_memcpy_ms=%.3f upload_gpu_copy_ms=%.3f gpu_timestamp_query_ms=%.3f gpu_timestamp_batches=%" PRIu64 " upload_direct_batches=%" PRIu64 "\n",
+                il, st.callbacks, st.callback_us/1000.0, st.route_sync_us/1000.0,
+                st.plan_us/1000.0, st.prefetch_us/1000.0, st.prefetch_bytes/1024.0/1024.0,
+                st.upload_us/1000.0, st.upload_wall_us/1000.0,
+                st.upload_calls, st.upload_batches, st.upload_bytes/1024.0/1024.0, st.upload_max_us/1000.0,
+                st.upload_major_faults, st.upload_minor_faults, expert_prefetch_enabled ? 1 : 0,
+                st.callback_process_read_bytes, st.callback_device_read_bytes, st.callback_major_faults,
+                st.callback_minor_faults,
+                st.upload_process_read_bytes, st.upload_device_read_bytes, st.async_read_wait_us/1000.0,
+                st.upload_source_copy_us/1000.0, st.upload_source_copy_thread_cpu_us/1000.0,
+                st.upload_source_copy_major_faults,
+                st.upload_source_copy_minor_faults, st.upload_source_mincore_us/1000.0,
+                st.upload_source_pages_checked, st.upload_source_pages_resident,
+                st.upload_staging_setup_us/1000.0,
+                st.upload_sync_before_us/1000.0, st.upload_command_record_us/1000.0,
+                st.upload_sync_after_us/1000.0, st.upload_sync_after_submit_us/1000.0,
+                st.upload_sync_after_wait_us/1000.0, st.upload_sync_after_host_memcpy_us/1000.0,
+                st.upload_gpu_copy_ns/1000000.0, st.upload_gpu_timestamp_query_us/1000.0,
+                st.upload_gpu_copy_timestamp_batches, st.upload_direct_batches);
+    }
+    auto log_io_phase = [](size_t il, const char * phase, const io_phase_stats & st) {
+        if (st.callbacks == 0) {
+            return;
+        }
+        const uint64_t non_cpu_wall_us = st.source_copy_us > st.source_copy_thread_cpu_us ?
+            st.source_copy_us - st.source_copy_thread_cpu_us : 0;
+        LLAMA_LOG_INFO("n3komata_moe_io_phase: layer=%zu phase=%s callbacks=%" PRIu64
+            " upload_mib=%.2f callback_process_read_mib=%.2f callback_device_read_mib=%.2f"
+            " upload_process_read_mib=%.2f upload_device_read_mib=%.2f"
+            " callback_major_faults=%" PRIu64 " callback_minor_faults=%" PRIu64
+            " async_read_jobs=%" PRIu64 " async_read_wait_ms=%.3f"
+            " async_worker_active_ms=%.3f async_worker_overlap_ms=%.3f"
+            " async_worker_ready_ahead_ms=%.3f async_worker_lead_ms=%.3f async_worker_queue_ms=%.3f"
+            " source_copy_wall_ms=%.3f source_copy_thread_cpu_ms=%.3f source_copy_non_cpu_wall_ms=%.3f"
+            " source_copy_major_faults=%" PRIu64 " source_copy_minor_faults=%" PRIu64
+            " source_pages_checked=%" PRIu64 " source_pages_resident=%" PRIu64
+            " source_madvise_cold_ms=%.3f source_madvise_cold_mib=%.2f"
+            " source_madvise_cold_ranges=%" PRIu64 " source_madvise_cold_failures=%" PRIu64
+            " gpu_copy_ms=%.3f gpu_timestamp_batches=%" PRIu64
+            " sync_before_ms=%.3f sync_after_ms=%.3f sync_submit_ms=%.3f sync_wait_ms=%.3f\n",
+            il, phase, st.callbacks, st.upload_bytes/1024.0/1024.0,
+            st.callback_process_read_bytes/1024.0/1024.0,
+            st.callback_device_read_bytes/1024.0/1024.0,
+            st.upload_process_read_bytes/1024.0/1024.0,
+            st.upload_device_read_bytes/1024.0/1024.0,
+            st.callback_major_faults, st.callback_minor_faults,
+            st.async_read_jobs, st.async_read_wait_us/1000.0,
+            st.async_read_worker_active_us/1000.0, st.async_read_worker_overlap_us/1000.0,
+            st.async_read_worker_ready_ahead_us/1000.0, st.async_read_worker_lead_us/1000.0,
+            st.async_read_worker_queue_us/1000.0,
+            st.source_copy_us/1000.0, st.source_copy_thread_cpu_us/1000.0, non_cpu_wall_us/1000.0,
+            st.source_copy_major_faults, st.source_copy_minor_faults,
+            st.source_pages_checked, st.source_pages_resident,
+            st.source_madvise_cold_us/1000.0, st.source_madvise_cold_bytes/1024.0/1024.0,
+            st.source_madvise_cold_ranges, st.source_madvise_cold_failures,
+            st.gpu_copy_ns/1000000.0, st.gpu_timestamp_batches,
+            st.sync_before_us/1000.0, st.sync_after_us/1000.0, st.sync_submit_us/1000.0, st.sync_wait_us/1000.0);
+        if (st.direct_read_requests > 0) {
+            LLAMA_LOG_INFO("n3komata_moe_source_read_phase: layer=%zu phase=%s requests=%" PRIu64
+                    " payload_mib=%.2f aligned_io_mib=%.2f parallel_wall_ms=%.3f worker_sum_ms=%.3f\n",
+                    il, phase, st.direct_read_requests,
+                    st.direct_read_payload_bytes/1024.0/1024.0,
+                    st.direct_read_io_bytes/1024.0/1024.0,
+                    st.direct_read_wall_us/1000.0, st.direct_read_worker_us/1000.0);
+        }
+    };
+    for (size_t il = 0; il < io_prefill_stats_by_layer.size(); ++il) {
+        log_io_phase(il, "prefill", io_prefill_stats_by_layer[il]);
+        log_io_phase(il, "decode", io_decode_stats_by_layer[il]);
+    }
+}
+
