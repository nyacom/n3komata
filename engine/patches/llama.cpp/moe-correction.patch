+void ggml_vk_kernel_gap_begin(ggml_backend_vk_context * ctx, vk_context& subctx, vk_kernel_gap_token& token) {
+    token.active = false;
+    if (!ctx->kernel_gap_profile_enabled || !ctx->kernel_gap_query_pool || !subctx->s) {
+        return;
+    }
+    if (ctx->kernel_gap_query_idx + 2 > ctx->kernel_gap_query_capacity) {
+        ctx->kernel_gap_dropped_samples++;
+        return;
+    }
+    token.query_start = ctx->kernel_gap_query_idx++;
+    token.submission_id = subctx->s->submission_id;
+    token.queue_family_index = subctx->p->q->queue_family_index;
+    subctx->s->buffer->buf.writeTimestamp(vk::PipelineStageFlagBits::eComputeShader,
+                                           ctx->kernel_gap_query_pool, token.query_start);
+    token.active = true;
+}
+
+void ggml_vk_kernel_gap_end(ggml_backend_vk_context * ctx, vk_context& subctx, const char * pipeline_name, vk_kernel_gap_token& token) {
+    if (!token.active) {
+        return;
+    }
+    const uint32_t query_end = ctx->kernel_gap_query_idx++;
+    subctx->s->buffer->buf.writeTimestamp(vk::PipelineStageFlagBits::eComputeShader,
+                                           ctx->kernel_gap_query_pool, query_end);
+    const uint64_t cpu_record_end_ns = ggml_vk_kernel_gap_host_time_ns();
+    vk_kernel_gap_sample sample;
+    sample.query_start = token.query_start;
+    sample.query_end = query_end;
+    sample.submission_id = token.submission_id;
+    sample.queue_family_index = token.queue_family_index;
+    sample.pipeline_name = pipeline_name ? pipeline_name : "";
+    sample.dispatch_elements = token.dispatch_elements;
+    sample.workgroups = token.workgroups;
+    sample.workgroup_denoms = token.workgroup_denoms;
+    sample.push_constant_words = token.push_constant_words;
+    sample.push_constant_word_count = token.push_constant_word_count;
+    sample.cpu_record_start_ns = token.cpu_record_start_ns;
+    sample.cpu_record_end_ns = cpu_record_end_ns;
+    ctx->kernel_gap_pending_samples.push_back(std::move(sample));
+    token.active = false;
+}
+
+static void ggml_vk_kernel_gap_drain(ggml_backend_vk_context * ctx) {
+    if (!ctx->kernel_gap_profile_enabled || ctx->kernel_gap_query_idx == 0 || !ctx->kernel_gap_query_pool) {
+        return;
+    }
+    std::vector<uint64_t> results(ctx->kernel_gap_query_idx);
+    const VkResult result = vkGetQueryPoolResults(
+        ctx->device->device,
+        ctx->kernel_gap_query_pool,
+        0,
+        ctx->kernel_gap_query_idx,
+        results.size() * sizeof(uint64_t),
+        results.data(),
+        sizeof(uint64_t),
+        VK_QUERY_RESULT_64_BIT);
+    if (result != VK_SUCCESS) {
+        GGML_LOG_WARN("n3komata_vk_kernel_gap: query results not ready (VkResult=%d); defer until next natural synchronization\n", result);
+        return;
+    }
+    for (auto & sample : ctx->kernel_gap_pending_samples) {
+        sample.gpu_start_ticks = results[sample.query_start];
+        sample.gpu_end_ticks = results[sample.query_end];
+        ctx->kernel_gap_samples.push_back(std::move(sample));
+    }
+    ctx->kernel_gap_pending_samples.clear();
+    ctx->device->device.resetQueryPool(ctx->kernel_gap_query_pool, 0, ctx->kernel_gap_query_idx);
+    ctx->kernel_gap_query_idx = 0;
+}
