+static bool ggml_vk_kernel_gap_calibrate(ggml_backend_vk_context * ctx) {
+    if (!ctx->device->calibrated_timestamps) {
+        return false;
+    }
+    auto get_calibrated = reinterpret_cast<PFN_vkGetCalibratedTimestampsEXT>(
+        vkGetDeviceProcAddr(ctx->device->device, "vkGetCalibratedTimestampsEXT"));
+    if (!get_calibrated) {
+        return false;
+    }
+    VkCalibratedTimestampInfoEXT infos[2] = {};
+    infos[0].sType = VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT;
+    infos[0].timeDomain = VK_TIME_DOMAIN_DEVICE_EXT;
+    infos[1].sType = VK_STRUCTURE_TYPE_CALIBRATED_TIMESTAMP_INFO_EXT;
+    infos[1].timeDomain = VK_TIME_DOMAIN_CLOCK_MONOTONIC_RAW_EXT;
+    uint64_t timestamps[2] = {};
+    uint64_t max_deviation = 0;
+    const VkResult result = get_calibrated(ctx->device->device, 2, infos, timestamps, &max_deviation);
+    if (result != VK_SUCCESS) {
+        return false;
+    }
+    ctx->kernel_gap_host_offset_ns = (double) timestamps[1] -
+        (double) timestamps[0] * ctx->kernel_gap_timestamp_period_ns;
+    ctx->kernel_gap_calibration_max_deviation_ns = std::max(
+        ctx->kernel_gap_calibration_max_deviation_ns, max_deviation);
+    ctx->kernel_gap_calibrations.push_back({timestamps[0], timestamps[1], max_deviation});
+    ctx->kernel_gap_calibration_valid = true;
+    return true;
+}
