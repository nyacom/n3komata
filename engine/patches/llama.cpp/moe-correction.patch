+static std::vector<std::vector<int32_t>> n3komata_load_protected_experts(
+        const llama_model_qwen4exp & model, const char * path) {
+    std::vector<std::vector<int32_t>> result(model.hparams.n_layer());
+    std::ifstream input(path);
+    if (!input) {
+        throw std::runtime_error(format("failed to open N3KOMATA_MOE_PROTECTED_EXPERTS_FILE: %s", path));
+    }
+    std::string line;
+    size_t line_number = 0;
+    while (std::getline(input, line)) {
+        line_number++;
+        if (line.empty() || line[0] == '#') {
+            continue;
+        }
+        std::replace(line.begin(), line.end(), ',', ' ');
+        std::istringstream fields(line);
+        long layer = -1;
+        long expert = -1;
+        if (!(fields >> layer >> expert)) {
+            if (line_number == 1) { // allow a CSV header
+                continue;
+            }
+            throw std::runtime_error(format("invalid protected expert row %zu in %s", line_number, path));
+        }
+        if (layer < 0 || layer >= model.hparams.n_layer() || expert < 0 || expert >= model.hparams.n_expert) {
+            throw std::runtime_error(format("protected expert out of range at row %zu in %s", line_number, path));
+        }
+        if (std::find(result[layer].begin(), result[layer].end(), expert) != result[layer].end()) {
+            throw std::runtime_error(format("duplicate protected expert %ld in layer %ld in %s", expert, layer, path));
+        }
+        result[layer].push_back((int32_t) expert);
+    }
+    return result;
+}
