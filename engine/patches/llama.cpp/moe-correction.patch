+static void ggml_vk_kernel_gap_write(ggml_backend_vk_context * ctx) {
+    if (!ctx->kernel_gap_profile_enabled || ctx->kernel_gap_output_path.empty()) {
+        return;
+    }
+    std::map<uint64_t, vk_kernel_gap_submit_event> submits;
+    for (const auto & event : ctx->kernel_gap_submit_events) {
+        submits[event.submission_id] = event;
+    }
+    auto samples = ctx->kernel_gap_samples;
+    std::stable_sort(samples.begin(), samples.end(), [](const auto & a, const auto & b) {
+        return a.gpu_start_ticks < b.gpu_start_ticks;
+    });
+    auto calibrations = ctx->kernel_gap_calibrations;
+    std::stable_sort(calibrations.begin(), calibrations.end(), [](const auto & a, const auto & b) {
+        return a.device_ticks < b.device_ticks;
+    });
+    auto calibrated_host_ns = [&](uint64_t device_ticks) -> long double {
+        if (calibrations.empty()) {
+            return std::numeric_limits<long double>::quiet_NaN();
+        }
+        auto upper = std::lower_bound(calibrations.begin(), calibrations.end(), device_ticks,
+            [](const vk_kernel_gap_calibration & calibration, uint64_t ticks) {
+                return calibration.device_ticks < ticks;
+            });
+        if (upper == calibrations.begin()) {
+            const auto & point = *upper;
+            return (long double) point.host_raw_ns +
+                ((long double) device_ticks - point.device_ticks) * ctx->kernel_gap_timestamp_period_ns;
+        }
+        if (upper == calibrations.end()) {
+            const auto & point = calibrations.back();
+            return (long double) point.host_raw_ns +
+                ((long double) device_ticks - point.device_ticks) * ctx->kernel_gap_timestamp_period_ns;
+        }
+        const auto & after = *upper;
+        const auto & before = *(upper - 1);
+        const uint64_t device_delta = after.device_ticks - before.device_ticks;
+        if (device_delta == 0) {
+            return (long double) before.host_raw_ns;
+        }
+        const long double fraction = ((long double) device_ticks - before.device_ticks) / device_delta;
+        return (long double) before.host_raw_ns +
+            fraction * ((long double) after.host_raw_ns - before.host_raw_ns);
+    };
+
+    std::ofstream out(ctx->kernel_gap_output_path);
+    if (!out) {
+        GGML_LOG_ERROR("n3komata_vk_kernel_gap: cannot open output '%s'\n", ctx->kernel_gap_output_path.c_str());
+        return;
+    }
+    out << "index,submission_id,queue_family,pipeline,elements0,elements1,elements2,workgroups0,workgroups1,workgroups2,workgroup_denom0,workgroup_denom1,workgroup_denom2,push_constant_word_count";
+    for (uint32_t i = 0; i < 16; ++i) out << ",push_word" << i;
+    out << ",gpu_start_ticks,gpu_end_ticks,gpu_start_monotonic_raw_ns,gpu_end_monotonic_raw_ns,gpu_duration_us,gap_from_previous_kernel_us,cpu_record_start_raw_ns,cpu_record_end_raw_ns,cpu_record_us,cpu_submit_start_raw_ns,cpu_submit_end_raw_ns,cpu_record_end_to_submit_start_us,submit_end_to_gpu_start_us,calibration_max_deviation_ns\n";
+    std::map<uint32_t, uint64_t> previous_gpu_end_by_queue;
+    size_t index = 0;
+    for (const auto & sample : samples) {
+        const double gpu_duration_ns = (double) (sample.gpu_end_ticks - sample.gpu_start_ticks) * ctx->kernel_gap_timestamp_period_ns;
+        double gap_us = std::numeric_limits<double>::quiet_NaN();
+        auto previous = previous_gpu_end_by_queue.find(sample.queue_family_index);
+        if (previous != previous_gpu_end_by_queue.end() && sample.gpu_start_ticks >= previous->second) {
+            gap_us = (double) (sample.gpu_start_ticks - previous->second) * ctx->kernel_gap_timestamp_period_ns / 1000.0;
+        }
+        previous_gpu_end_by_queue[sample.queue_family_index] = sample.gpu_end_ticks;
+
+        const long double gpu_start_host_ns = calibrated_host_ns(sample.gpu_start_ticks);
+        const long double gpu_end_host_ns = calibrated_host_ns(sample.gpu_end_ticks);
+
+        uint64_t submit_start_ns = 0;
+        uint64_t submit_end_ns = 0;
+        auto submit = submits.find(sample.submission_id);
+        if (submit != submits.end()) {
+            submit_start_ns = submit->second.cpu_submit_start_ns;
+            submit_end_ns = submit->second.cpu_submit_end_ns;
+        }
+        const double cpu_record_us = (double) (sample.cpu_record_end_ns - sample.cpu_record_start_ns) / 1000.0;
+        const double record_to_submit_us = submit_start_ns
+            ? ((double) submit_start_ns - (double) sample.cpu_record_end_ns) / 1000.0
+            : std::numeric_limits<double>::quiet_NaN();
+        const double submit_to_gpu_us = submit_end_ns && std::isfinite((double) gpu_start_host_ns)
+            ? ((double) gpu_start_host_ns - (double) submit_end_ns) / 1000.0
+            : std::numeric_limits<double>::quiet_NaN();
+
+        out << index++ << ',' << sample.submission_id << ',' << sample.queue_family_index << ','
+            << '"' << sample.pipeline_name << '"' << ','
