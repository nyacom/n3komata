+static void n3komata_load_expert_substitution(llama_model_qwen4exp & model) {
+    const char * mode = std::getenv("N3KOMATA_MOE_SUBSTITUTION_MODE");
+    if (mode == nullptr || *mode == '\0') {
+        return;
+    }
+
+    const int layer_id = n3komata_env_index("N3KOMATA_MOE_SUBSTITUTION_LAYER", model.hparams.n_layer());
+    const int target_id = n3komata_env_index("N3KOMATA_MOE_SUBSTITUTION_TARGET", model.hparams.n_expert);
+    const int base_id = n3komata_env_index("N3KOMATA_MOE_SUBSTITUTION_BASE", model.hparams.n_expert);
+    if (target_id == base_id) {
+        throw std::runtime_error("substitution target and base expert must differ");
+    }
+
+    if (model.hparams.n_embd <= 0 || model.hparams.n_embd > 32768 ||
+            model.hparams.n_expert == 0 || model.hparams.n_expert > 65536) {
+        throw std::runtime_error("model dimensions are outside the expert substitution limits");
+    }
+
+    const bool omit = std::strcmp(mode, "omit") == 0;
+    const bool substitute = std::strcmp(mode, "substitute") == 0;
+    const bool corrected = std::strcmp(mode, "corrected") == 0;
+    if (!omit && !substitute && !corrected) {
+        throw std::runtime_error(format("unsupported N3KOMATA_MOE_SUBSTITUTION_MODE: %s", mode));
+    }
+
+    const int64_t hidden = model.hparams.n_embd;
+    int rank = 0;
+    std::vector<uint16_t> u_data;
+    std::vector<uint16_t> v_data;
+    std::vector<uint16_t> bias_data;
+    if (corrected) {
+        const char * path = std::getenv("N3KOMATA_MOE_SUBSTITUTION_ADAPTER");
+        if (path == nullptr || *path == '\0') {
+            throw std::runtime_error("N3KOMATA_MOE_SUBSTITUTION_ADAPTER must be set for corrected mode");
+        }
+
+        std::ifstream file(path, std::ios::binary);
+        if (!file) {
+            throw std::runtime_error(format("cannot open expert correction: %s", path));
+        }
+        char magic[8] = {};
+        uint32_t version = 0;
+        uint32_t adapter_hidden = 0;
+        uint32_t adapter_rank = 0;
+        file.read(magic, sizeof(magic));
+        file.read((char *) &version, sizeof(version));
+        file.read((char *) &adapter_hidden, sizeof(adapter_hidden));
+        file.read((char *) &adapter_rank, sizeof(adapter_rank));
+        if (!file || std::memcmp(magic, "N3KMOE1\0", sizeof(magic)) != 0 || version != 1 ||
+                adapter_hidden != (uint32_t) hidden || adapter_rank == 0 || adapter_rank > 256 || adapter_rank > adapter_hidden) {
+            throw std::runtime_error("invalid expert correction header");
+        }
+        rank = (int) adapter_rank;
+        const size_t factor_count = (size_t) hidden * (size_t) rank;
+        u_data.resize(factor_count);
+        v_data.resize(factor_count);
+        bias_data.resize((size_t) hidden);
+        file.read((char *) u_data.data(), (std::streamsize) (u_data.size() * sizeof(uint16_t)));
+        file.read((char *) v_data.data(), (std::streamsize) (v_data.size() * sizeof(uint16_t)));
+        file.read((char *) bias_data.data(), (std::streamsize) (bias_data.size() * sizeof(uint16_t)));
+        if (!file || file.peek() != std::ifstream::traits_type::eof()) {
+            throw std::runtime_error("expert correction has a truncated or unexpected payload");
+        }
+    }
+
+    ggml_init_params ctx_params = {
+        /*.mem_size   =*/ 6 * ggml_tensor_overhead(),
+        /*.mem_buffer =*/ nullptr,
+        /*.no_alloc   =*/ true,
+    };
+    ggml_context_ptr ctx { ggml_init(ctx_params) };
+    if (!ctx) {
+        throw std::runtime_error("failed to create expert substitution context");
+    }
+
+    llama_layer & layer = model.layers[layer_id];
+    layer.ffn_expert_subst_ids = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, 1, model.hparams.n_expert);
+    layer.ffn_expert_subst_target_mask = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 1, model.hparams.n_expert);
+    layer.ffn_expert_subst_keep_mask = omit ? ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 1, model.hparams.n_expert) : nullptr;
+    if (corrected) {
+        layer.ffn_expert_corr_u = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, hidden, rank);
+        layer.ffn_expert_corr_v = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, rank, hidden);
+        layer.ffn_expert_corr_bias = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F16, hidden);
+    }
+
+    ggml_backend_buffer_type_t buft = model.select_buft(layer_id);
+    ggml_backend_buffer_ptr buffer;
+    if (model.hparams.no_alloc) {
+        buffer.reset(ggml_backend_buft_alloc_buffer(buft, 0));
+        for (ggml_tensor * tensor = ggml_get_first_tensor(ctx.get()); tensor != nullptr; tensor = ggml_get_next_tensor(ctx.get(), tensor)) {
+            tensor->buffer = buffer.get();
+        }
+    } else {
+        buffer.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft));
+    }
+    if (!buffer) {
+        throw std::runtime_error(format("failed to allocate expert substitution on %s", ggml_backend_buft_name(buft)));
+    }
+    ggml_backend_buffer_set_usage(buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+    std::vector<int32_t> id_map(model.hparams.n_expert);
+    std::vector<float> target_mask(model.hparams.n_expert, 0.0f);
+    std::vector<float> keep_mask(model.hparams.n_expert, 1.0f);
+    for (int32_t expert = 0; expert < (int32_t) model.hparams.n_expert; ++expert) {
+        id_map[expert] = expert == target_id ? base_id : expert;
+    }
+    target_mask[target_id] = 1.0f;
+    keep_mask[target_id] = 0.0f;
+    if (!model.hparams.no_alloc) {
+        ggml_backend_tensor_set(layer.ffn_expert_subst_ids, id_map.data(), 0, ggml_nbytes(layer.ffn_expert_subst_ids));
+        ggml_backend_tensor_set(layer.ffn_expert_subst_target_mask, target_mask.data(), 0, ggml_nbytes(layer.ffn_expert_subst_target_mask));
+        if (omit) {
+            ggml_backend_tensor_set(layer.ffn_expert_subst_keep_mask, keep_mask.data(), 0, ggml_nbytes(layer.ffn_expert_subst_keep_mask));
+        }
+        if (corrected) {
+            ggml_backend_tensor_set(layer.ffn_expert_corr_u, u_data.data(), 0, ggml_nbytes(layer.ffn_expert_corr_u));
+            ggml_backend_tensor_set(layer.ffn_expert_corr_v, v_data.data(), 0, ggml_nbytes(layer.ffn_expert_corr_v));
+            ggml_backend_tensor_set(layer.ffn_expert_corr_bias, bias_data.data(), 0, ggml_nbytes(layer.ffn_expert_corr_bias));
+        }
+    }
+
+    model.keep_aux_buffer(ctx.release(), buffer.release());
+    LLAMA_LOG_INFO("n3komata expert substitution: mode = %s, layer = %d, target = %d, base = %d, rank = %d\n",
+            mode, layer_id, target_id, base_id, rank);
+}
+
+// Load per-layer low-rank surrogates for the router-weighted average output of
+// Experts removed by fixed-K skipping. The runtime multiplies each surrogate by
+// the token's original omitted-route mass.
+static void n3komata_load_expert_tail_correction(llama_model_qwen4exp & model) {
+    const char * path = std::getenv("N3KOMATA_MOE_TAIL_ADAPTER_FILE");
+    if (path == nullptr || *path == '\0') {
+        return;
+    }
+
+    std::ifstream file(path, std::ios::binary);
+    if (!file) {
+        throw std::runtime_error(format("cannot open MoE tail adapter: %s", path));
+    }
+    char magic[8] = {};
+    uint32_t version = 0;
+    uint32_t n_layers = 0;
+    uint32_t hidden = 0;
+    uint32_t rank = 0;
+    file.read(magic, sizeof(magic));
+    file.read((char *) &version, sizeof(version));
+    file.read((char *) &n_layers, sizeof(n_layers));
+    file.read((char *) &hidden, sizeof(hidden));
+    file.read((char *) &rank, sizeof(rank));
+    if (!file || std::memcmp(magic, "N3TAIL1\0", sizeof(magic)) != 0 || version != 1 ||
+            n_layers != model.hparams.n_layer() || hidden != model.hparams.n_embd ||
+            rank == 0 || rank > 256 || rank > hidden) {
+        throw std::runtime_error("invalid MoE tail adapter header or model dimensions");
+    }
+
+    for (uint32_t il = 0; il < n_layers; ++il) {
+        llama_layer & layer = model.layers[il];
+        const uint32_t original_k = model.hparams.n_expert_used(il);
+        if (layer.ffn_expert_skip_k <= 0 || (uint32_t) layer.ffn_expert_skip_k >= original_k) {
+            throw std::runtime_error(format("MoE tail adapter requires fixed expert skipping on layer %u", il));
+        }
+
+        const size_t factor_count = (size_t) hidden * rank;
+        std::vector<uint16_t> u_data(factor_count);
+        std::vector<uint16_t> v_data(factor_count);
+        std::vector<uint16_t> bias_data(hidden);
+        file.read((char *) u_data.data(), (std::streamsize) (u_data.size() * sizeof(uint16_t)));
+        file.read((char *) v_data.data(), (std::streamsize) (v_data.size() * sizeof(uint16_t)));
+        file.read((char *) bias_data.data(), (std::streamsize) (bias_data.size() * sizeof(uint16_t)));
+        if (!file) {
+            throw std::runtime_error(format("truncated MoE tail adapter at layer %u", il));
+        }
+
+        ggml_init_params ctx_params = {
+            /*.mem_size   =*/ 8 * ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context_ptr ctx { ggml_init(ctx_params) };
+        if (!ctx) {
+            throw std::runtime_error("failed to create MoE tail adapter context");
+        }
+        layer.ffn_expert_tail_corr_u = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, hidden, rank);
+        layer.ffn_expert_tail_corr_v = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, rank, hidden);
+        layer.ffn_expert_tail_corr_bias = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F16, hidden);
+
+        ggml_backend_buffer_type_t buft = model.select_buft(il);
+        ggml_backend_buffer_ptr buffer;
+        if (model.hparams.no_alloc) {
+            // Parameter-fit probes create placeholder buffers and inspect only
+            // their planned size; they don't execute the model graph.
+            buffer.reset(ggml_backend_buft_alloc_buffer(buft, 0));
+            for (ggml_tensor * tensor = ggml_get_first_tensor(ctx.get()); tensor != nullptr; tensor = ggml_get_next_tensor(ctx.get(), tensor)) {
+                tensor->buffer = buffer.get();
+            }
+        } else {
+            buffer.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft));
+        }
+        if (!buffer) {
+            throw std::runtime_error(format("failed to allocate MoE tail adapter on %s", ggml_backend_buft_name(buft)));
+        }
+        ggml_backend_buffer_set_usage(buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        if (!model.hparams.no_alloc) {
+            ggml_backend_tensor_set(layer.ffn_expert_tail_corr_u, u_data.data(), 0, ggml_nbytes(layer.ffn_expert_tail_corr_u));
+            ggml_backend_tensor_set(layer.ffn_expert_tail_corr_v, v_data.data(), 0, ggml_nbytes(layer.ffn_expert_tail_corr_v));
+            ggml_backend_tensor_set(layer.ffn_expert_tail_corr_bias, bias_data.data(), 0, ggml_nbytes(layer.ffn_expert_tail_corr_bias));
+        }
+        model.keep_aux_buffer(ctx.release(), buffer.release());
+    }
+    if (file.peek() != std::ifstream::traits_type::eof()) {
+        throw std::runtime_error("MoE tail adapter has unexpected trailing data");
+    }
+    LLAMA_LOG_INFO("n3komata expert tail adapter: layers=%u hidden=%u rank=%u source=%s\n",
+            n_layers, hidden, rank, path);
+}
+
+// Load sparse, per-layer residual vectors keyed by the unordered set of the
+// router's top-3 Expert IDs. The graph performs the key match on the GPU and
+// adds the matching vector to the global low-rank tail surrogate.
+static void n3komata_load_expert_tail_combo_table(llama_model_qwen4exp & model) {
+    const char * path = std::getenv("N3KOMATA_MOE_TAIL_COMBO_FILE");
+    if (path == nullptr || *path == '\0') {
+        return;
+    }
+    if (std::getenv("N3KOMATA_MOE_TAIL_ADAPTER_FILE") == nullptr ||
+            *std::getenv("N3KOMATA_MOE_TAIL_ADAPTER_FILE") == '\0') {
+        throw std::runtime_error("N3KOMATA_MOE_TAIL_COMBO_FILE requires N3KOMATA_MOE_TAIL_ADAPTER_FILE");
+    }
+
+    std::ifstream file(path, std::ios::binary);
+    if (!file) {
+        throw std::runtime_error(format("cannot open MoE top-3 combo table: %s", path));
+    }
+    char magic[8] = {};
+    uint32_t version = 0;
+    uint32_t n_layers = 0;
+    uint32_t hidden = 0;
+    uint32_t n_experts = 0;
+    uint32_t min_count = 0;
+    float prior_strength = 0.0f;
+    file.read(magic, sizeof(magic));
+    file.read((char *) &version, sizeof(version));
+    file.read((char *) &n_layers, sizeof(n_layers));
+    file.read((char *) &hidden, sizeof(hidden));
+    file.read((char *) &n_experts, sizeof(n_experts));
+    file.read((char *) &min_count, sizeof(min_count));
+    file.read((char *) &prior_strength, sizeof(prior_strength));
+    if (!file || std::memcmp(magic, "N3COMB1\0", sizeof(magic)) != 0 || version != 1 ||
+            n_layers != model.hparams.n_layer() || hidden != model.hparams.n_embd ||
+            n_experts != model.hparams.n_expert || min_count == 0 ||
+            !std::isfinite(prior_strength) || prior_strength < 0.0f) {
+        throw std::runtime_error("invalid MoE top-3 combo table header or model dimensions");
+    }
+
+    const std::vector<uint16_t> identity = [&]() {
+        std::vector<uint16_t> result((size_t) n_experts * n_experts, 0);
+        for (uint32_t i = 0; i < n_experts; ++i) {
+            result[(size_t) i * n_experts + i] = 0x3c00; // FP16(1.0)
+        }
+        return result;
+    }();
+
+    for (uint32_t il = 0; il < n_layers; ++il) {
+        llama_layer & layer = model.layers[il];
+        if (layer.ffn_expert_tail_corr_u == nullptr ||
+                layer.ffn_expert_skip_k != 3 || model.hparams.n_expert_used(il) <= 3) {
+            throw std::runtime_error(format("top-3 combo table requires K=3 tail correction on layer %u", il));
+        }
+        uint32_t count = 0;
+        file.read((char *) &count, sizeof(count));
+        if (!file || count > 4096) {
+            throw std::runtime_error(format("invalid top-3 combo count in layer %u", il));
+        }
+        std::vector<int32_t> keys((size_t) count * 3);
+        std::vector<uint16_t> residuals((size_t) count * hidden);
+        file.read((char *) keys.data(), (std::streamsize) (keys.size() * sizeof(int32_t)));
+        file.read((char *) residuals.data(), (std::streamsize) (residuals.size() * sizeof(uint16_t)));
+        if (!file) {
+            throw std::runtime_error(format("truncated top-3 combo table at layer %u", il));
+        }
+
+        for (uint32_t i = 0; i < count; ++i) {
+            const int32_t a = keys[(size_t) i * 3 + 0];
+            const int32_t b = keys[(size_t) i * 3 + 1];
+            const int32_t c = keys[(size_t) i * 3 + 2];
+            if (a < 0 || b <= a || c <= b || (uint32_t) c >= n_experts) {
+                throw std::runtime_error(format("invalid top-3 combo key in layer %u entry %u", il, i));
+            }
+        }
+        if (count == 0) {
+            continue;
+        }
+
+        ggml_init_params ctx_params = {
+            /*.mem_size   =*/ 8 * ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context_ptr ctx { ggml_init(ctx_params) };
+        if (!ctx) {
+            throw std::runtime_error("failed to create MoE top-3 combo table context");
+        }
+        layer.ffn_expert_tail_combo_id_eye = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, n_experts, n_experts);
+        layer.ffn_expert_tail_combo_membership = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, n_experts, count);
+        layer.ffn_expert_tail_combo_bias = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F16, count, hidden);
+
+        // For a three-ID set, score=overlap-(2*non_overlap). Only a complete
+        // match scores > 0 (3 -> +3, 2 -> 0, 1 -> -3, 0 -> -6), so the graph
+        // can use STEP without constructing a scalar threshold tensor.
+        std::vector<uint16_t> membership((size_t) count * n_experts, 0xc000); // FP16(-2.0)
+        for (uint32_t i = 0; i < count; ++i) {
+            for (uint32_t k = 0; k < 3; ++k) {
+                const uint32_t expert = (uint32_t) keys[(size_t) i * 3 + k];
+                membership[(size_t) i * n_experts + expert] = 0x3c00; // FP16(+1.0)
+            }
+        }
+        // ggml_mul_mat expects its reduction dimension in ne[0]. Keep the
+        // residual lookup matrix as [n_combo, hidden] and transpose the
+        // combo-major file payload into hidden-major tensor storage.
+        std::vector<uint16_t> residuals_transposed((size_t) count * hidden);
+        for (uint32_t combo = 0; combo < count; ++combo) {
+            for (uint32_t h = 0; h < hidden; ++h) {
+                residuals_transposed[(size_t) h * count + combo] = residuals[(size_t) combo * hidden + h];
+            }
+        }
+
+        ggml_backend_buffer_type_t buft = model.select_buft(il);
+        ggml_backend_buffer_ptr buffer;
+        if (model.hparams.no_alloc) {
+            buffer.reset(ggml_backend_buft_alloc_buffer(buft, 0));
+            for (ggml_tensor * tensor = ggml_get_first_tensor(ctx.get()); tensor != nullptr; tensor = ggml_get_next_tensor(ctx.get(), tensor)) {
+                tensor->buffer = buffer.get();
+            }
+        } else {
+            buffer.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft));
+        }
+        if (!buffer) {
+            throw std::runtime_error(format("failed to allocate top-3 combo table on %s", ggml_backend_buft_name(buft)));
+        }
+        ggml_backend_buffer_set_usage(buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        if (!model.hparams.no_alloc) {
+            ggml_backend_tensor_set(layer.ffn_expert_tail_combo_id_eye, identity.data(), 0,
+                    ggml_nbytes(layer.ffn_expert_tail_combo_id_eye));
+            ggml_backend_tensor_set(layer.ffn_expert_tail_combo_membership, membership.data(), 0,
+                    ggml_nbytes(layer.ffn_expert_tail_combo_membership));
+            ggml_backend_tensor_set(layer.ffn_expert_tail_combo_bias, residuals_transposed.data(), 0,
+                    ggml_nbytes(layer.ffn_expert_tail_combo_bias));
+        }
+        model.keep_aux_buffer(ctx.release(), buffer.release());
+    }
+    if (file.peek() != std::ifstream::traits_type::eof()) {
+        throw std::runtime_error("MoE top-3 combo table has unexpected trailing data");
+    }
+    LLAMA_LOG_INFO("n3komata expert top-3 combo residuals: layers=%u hidden=%u experts=%u min_count=%u prior=%.2f source=%s\n",
+            n_layers, hidden, n_experts, min_count, prior_strength, path);
+}
+
+// Experimental path for measuring the MoE execution pipeline with all selected
+// Experts guaranteed resident. Router weights are retained, while the routed
+// Expert IDs are replaced by this fixed set in every layer.
+static void n3komata_load_force_resident_ids(llama_model_qwen4exp & model) {
+    const char * value = std::getenv("N3KOMATA_MOE_FORCE_RESIDENT_IDS");
+    if (value == nullptr || *value == '\0') {
+        return;
+    }
+    if (std::getenv("N3KOMATA_MOE_SUBSTITUTION_MODE") != nullptr ||
+            std::getenv("N3KOMATA_MOE_DYNAMIC_K") != nullptr ||
+            std::getenv("N3KOMATA_MOE_SKIP_K") != nullptr ||
+            std::getenv("N3KOMATA_MOE_SKIP_POLICY") != nullptr) {
+        throw std::runtime_error("N3KOMATA_MOE_FORCE_RESIDENT_IDS cannot be combined with substitution, dynamic K, or expert skipping");
+    }
+
+    std::vector<int32_t> expert_ids;
+    std::stringstream values(value);
+    std::string field;
+    while (std::getline(values, field, ',')) {
+        if (field.empty()) {
+            throw std::runtime_error("N3KOMATA_MOE_FORCE_RESIDENT_IDS contains an empty entry");
+        }
+        char * end = nullptr;
+        const long expert = std::strtol(field.c_str(), &end, 10);
+        if (end == field.c_str() || *end != '\0' || expert < 0 || expert >= model.hparams.n_expert ||
+                std::find(expert_ids.begin(), expert_ids.end(), (int32_t) expert) != expert_ids.end()) {
+            throw std::runtime_error(format("invalid or duplicate Expert ID in N3KOMATA_MOE_FORCE_RESIDENT_IDS: %s", field.c_str()));
+        }
+        expert_ids.push_back((int32_t) expert);
+    }
+    if (expert_ids.empty()) {
+        throw std::runtime_error("N3KOMATA_MOE_FORCE_RESIDENT_IDS must contain at least one Expert ID");
+    }
+
+    for (uint32_t il = 0; il < model.hparams.n_layer(); ++il) {
+        const uint32_t routed_k = model.hparams.n_expert_used(il);
+        if (expert_ids.size() != routed_k) {
+            throw std::runtime_error(format("N3KOMATA_MOE_FORCE_RESIDENT_IDS has %zu IDs, but layer %u routes top-%u",
+                    expert_ids.size(), il, routed_k));
+        }
+        llama_layer & layer = model.layers[il];
+        ggml_init_params ctx_params = {
+            /*.mem_size   =*/ 2 * ggml_tensor_overhead(),
+            /*.mem_buffer =*/ nullptr,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context_ptr ctx { ggml_init(ctx_params) };
+        if (!ctx) {
+            throw std::runtime_error("failed to create fixed resident Expert context");
+        }
+        layer.ffn_expert_force_ids = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, expert_ids.size());
+        ggml_backend_buffer_type_t buft = model.select_buft(il);
+        ggml_backend_buffer_ptr buffer;
+        if (model.hparams.no_alloc) {
+            buffer.reset(ggml_backend_buft_alloc_buffer(buft, 0));
+            layer.ffn_expert_force_ids->buffer = buffer.get();
+        } else {
+            buffer.reset(ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft));
+        }
+        if (!buffer) {
+            throw std::runtime_error(format("failed to allocate fixed resident Expert IDs on %s", ggml_backend_buft_name(buft)));
+        }
+        ggml_backend_buffer_set_usage(buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+        if (!model.hparams.no_alloc) {
