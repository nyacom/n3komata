+    void start_transition_read_worker() {
+        transition_read_thread = std::thread([this]() {
+            for (;;) {
+                llama_memory_ranges ranges;
+                uint64_t job_id = 0;
+                {
+                    std::unique_lock<std::mutex> lock(transition_read_mutex);
+                    transition_read_request.wait(lock, [&]() { return transition_read_stop || transition_read_pending; });
+                    if (transition_read_stop && !transition_read_pending) {
+                        return;
+                    }
+                    ranges = std::move(transition_read_ranges);
+                    job_id = transition_read_submitted;
+                    transition_read_pending = false;
+                }
+
+                // The ranges are built in router order, which interleaves large mmap
+                // tensors. Visit them in file-address order so the page-cache read-ahead
+                // and explicit page touches walk each mapped shard more sequentially.
+                std::sort(ranges.begin(), ranges.end(), [](const llama_memory_range & a, const llama_memory_range & b) {
+                    return (uintptr_t) a.addr < (uintptr_t) b.addr;
+                });
+
+                if (transition_read_start_delay_us > 0) {
+                    std::this_thread::sleep_for(std::chrono::microseconds(transition_read_start_delay_us));
+                }
+                const auto job_start = std::chrono::steady_clock::now();
+                const uint64_t faults_before = llama_moe_thread_major_faults();
+                const uint64_t minor_faults_before = llama_moe_thread_minor_faults();
+                const auto hint_start = std::chrono::steady_clock::now();
+                llama_prefetch(ranges);
+                const uint64_t hint_us = llama_moe_elapsed_us(hint_start);
+
+#if defined(__linux__) || defined(__APPLE__)
+                const long page_size = sysconf(_SC_PAGESIZE);
+#else
+                const long page_size = 4096;
+#endif
+                uint64_t pages = 0;
+                uint64_t bytes = 0;
+                uint8_t checksum = 0;
+                const auto touch_start = std::chrono::steady_clock::now();
+                for (const llama_memory_range & range : ranges) {
+                    if (!range.addr || range.size == 0) {
+                        continue;
+                    }
+                    const uintptr_t begin = (uintptr_t) range.addr;
+                    const uintptr_t end = begin + range.size;
+                    if (end < begin) {
+                        continue;
+                    }
+                    bytes += range.size;
+                    const size_t stride = page_size > 0 ? (size_t) page_size : 4096;
+                    for (uintptr_t addr = begin; addr < end;) {
+                        checksum ^= *(const volatile uint8_t *) addr;
+                        pages++;
+                        if (end - addr <= stride) {
+                            break;
+                        }
+                        addr += stride;
+                    }
+                }
+                const uint64_t touch_us = llama_moe_elapsed_us(touch_start);
+                const uint64_t faults_after = llama_moe_thread_major_faults();
+                const uint64_t minor_faults_after = llama_moe_thread_minor_faults();
+                const auto job_end = std::chrono::steady_clock::now();
+                const uint64_t job_us = (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(job_end - job_start).count();
+
+                {
+                    std::lock_guard<std::mutex> lock(transition_read_mutex);
+                    transition_read_completed = job_id;
+                    transition_read_duration_us = job_us;
+                    transition_read_started_at = job_start;
+                    transition_read_completed_at = job_end;
+                    transition_read_hint_us = hint_us;
+                    transition_read_touch_us = touch_us;
+                    transition_read_faults = faults_after >= faults_before ? faults_after - faults_before : 0;
+                    transition_read_minor_faults = minor_faults_after >= minor_faults_before ? minor_faults_after - minor_faults_before : 0;
+                    transition_read_pages = pages;
+                    transition_read_bytes = bytes;
+                    transition_read_checksum = checksum;
+                }
+                transition_read_complete.notify_all();
+            }
+        });
+    }
