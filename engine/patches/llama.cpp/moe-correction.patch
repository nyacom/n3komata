+    void start_async_expert_prefetch_worker() {
+        async_expert_prefetch_thread = std::thread([this]() {
+            for (;;) {
+                std::vector<async_expert_prefetch_job> jobs;
+                {
+                    std::unique_lock<std::mutex> lock(async_expert_prefetch_mutex);
+                    async_expert_prefetch_request.wait(lock, [&]() {
+                        return async_expert_prefetch_stop || !async_expert_prefetch_queue.empty();
+                    });
+                    if (async_expert_prefetch_stop && async_expert_prefetch_queue.empty()) {
+                        return;
+                    }
+                    if (async_expert_prefetch_batch_us > 0) {
+                        const auto deadline = std::chrono::steady_clock::now() +
+                                std::chrono::microseconds(async_expert_prefetch_batch_us);
+                        while (!async_expert_prefetch_stop && std::chrono::steady_clock::now() < deadline) {
+                            async_expert_prefetch_request.wait_until(lock, deadline);
+                        }
+                    }
+                    while (!async_expert_prefetch_queue.empty()) {
+                        jobs.push_back(std::move(async_expert_prefetch_queue.front()));
+                        async_expert_prefetch_queue.pop_front();
+                    }
+                }
+
+                llama_memory_ranges ranges;
+                size_t n_ranges = 0;
+                uint64_t n_bytes = 0;
+                auto first_submitted_at = jobs.front().submitted_at;
+                for (auto & job : jobs) {
+                    first_submitted_at = std::min(first_submitted_at, job.submitted_at);
+                    n_ranges += job.ranges.size();
+                    for (const auto & range : job.ranges) {
+                        n_bytes += range.size;
+                    }
+                    ranges.insert(ranges.end(),
+                            std::make_move_iterator(job.ranges.begin()),
+                            std::make_move_iterator(job.ranges.end()));
+                }
+
+                const auto worker_start = std::chrono::steady_clock::now();
+                const uint64_t cpu_start_us = llama_moe_thread_cpu_time_us();
+                llama_prefetch(std::move(ranges));
+                const uint64_t cpu_end_us = llama_moe_thread_cpu_time_us();
+                const auto worker_end = std::chrono::steady_clock::now();
+                const uint64_t wall_us = (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+                        worker_end - worker_start).count();
+                const uint64_t cpu_us = cpu_end_us >= cpu_start_us ? cpu_end_us - cpu_start_us : 0;
+                const uint64_t queue_us = (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+                        worker_start - first_submitted_at).count();
+                {
+                    std::lock_guard<std::mutex> lock(async_expert_prefetch_mutex);
+                    async_expert_prefetch_batches++;
+                    async_expert_prefetch_jobs += jobs.size();
+                    async_expert_prefetch_ranges += n_ranges;
+                    async_expert_prefetch_bytes += n_bytes;
+                    async_expert_prefetch_worker_wall_us += wall_us;
+                    async_expert_prefetch_worker_cpu_us += cpu_us;
+                    async_expert_prefetch_queue_delay_us += queue_us;
+                    async_expert_prefetch_max_batch_jobs = std::max<uint64_t>(async_expert_prefetch_max_batch_jobs, jobs.size());
+                }
+            }
+        });
+    }
