+uint64_t llama_moe_steady_time_ns() {
+    return (uint64_t) std::chrono::duration_cast<std::chrono::nanoseconds>(
+            std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+uint64_t llama_moe_thread_major_faults() {
+#if defined(__linux__)
+    struct rusage usage = {};
+#if defined(RUSAGE_THREAD)
+    if (getrusage(RUSAGE_THREAD, &usage) == 0) {
+#else
+    if (getrusage(RUSAGE_SELF, &usage) == 0) {
+#endif
+        return (uint64_t) usage.ru_majflt;
+    }
+#endif
+    return 0;
+}
+
+uint64_t llama_moe_thread_minor_faults() {
+#if defined(__linux__)
+    struct rusage usage = {};
+#if defined(RUSAGE_THREAD)
+    if (getrusage(RUSAGE_THREAD, &usage) == 0) {
+#else
+    if (getrusage(RUSAGE_SELF, &usage) == 0) {
+#endif
+        return (uint64_t) usage.ru_minflt;
+    }
+#endif
+    return 0;
+}
+
+uint64_t llama_moe_thread_cpu_time_us() {
+#if defined(__linux__)
+    struct timespec ts = {};
+    if (clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) == 0) {
+        return (uint64_t) ts.tv_sec * 1000000 + (uint64_t) ts.tv_nsec / 1000;
+    }
+#endif
+    return 0;
+}
+
+bool llama_moe_process_read_bytes(uint64_t * bytes) {
+#if defined(__linux__)
+    std::ifstream io("/proc/self/io");
+    std::string key;
+    uint64_t value = 0;
+    while (io >> key >> value) {
+        if (key == "read_bytes:") {
+            *bytes = value;
+            return true;
+        }
+    }
+#else
+    GGML_UNUSED(bytes);
+#endif
+    return false;
+}
+
+bool llama_moe_device_read_bytes(uint64_t * bytes) {
+#if defined(__linux__)
+    const char * path = std::getenv("N3KOMATA_MOE_IO_DEVICE_STAT");
+    std::ifstream stat(path != nullptr && path[0] != '\0' ? path : "/sys/block/nvme0n1/stat");
+    uint64_t reads = 0;
+    uint64_t merged = 0;
+    uint64_t sectors = 0;
+    if (stat >> reads >> merged >> sectors) {
+        *bytes = sectors * 512;
+        return true;
+    }
+#else
+    GGML_UNUSED(bytes);
+#endif
+    return false;
+}
+
+uint64_t llama_moe_counter_delta(uint64_t before, bool before_valid, uint64_t after, bool after_valid) {
+    return before_valid && after_valid && after >= before ? after - before : 0;
+}
