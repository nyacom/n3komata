+static uint64_t qwen4exp_ple_predictor_key(int32_t layer, int32_t head, int32_t row) {
+    return ((uint64_t) (uint16_t) layer << 48) |
+           ((uint64_t) (uint16_t) head << 32) |
+           (uint32_t) row;
+}
+
+static qwen4exp_ple_expert_predictor_state * qwen4exp_get_ple_expert_predictor() {
+    static qwen4exp_ple_expert_predictor_state state;
+    if (state.initialized) {
+        return state.enabled ? &state : nullptr;
+    }
+    state.initialized = true;
+
+    const char * path = std::getenv("N3KOMATA_PLE_EXPERT_PREDICTOR");
+    if (path == nullptr || path[0] == '\0') {
+        return nullptr;
+    }
+    const char * layer_env = std::getenv("N3KOMATA_PLE_EXPERT_PREFETCH_LAYER");
+    if (layer_env == nullptr || layer_env[0] == '\0') {
+        throw std::runtime_error("N3KOMATA_PLE_EXPERT_PREFETCH_LAYER is required with N3KOMATA_PLE_EXPERT_PREDICTOR");
+    }
+    char * end = nullptr;
+    state.layer = (int32_t) std::strtol(layer_env, &end, 10);
+    if (end == layer_env || *end != '\0' || state.layer < 0 || state.layer > UINT16_MAX) {
+        throw std::runtime_error(format("invalid N3KOMATA_PLE_EXPERT_PREFETCH_LAYER='%s'", layer_env));
+    }
+    if (const char * admission = std::getenv("N3KOMATA_PLE_EXPERT_CACHE_ADMISSION")) {
+        state.cache_admission_enabled = std::atoi(admission) != 0;
+    }
+    if (const char * stage = std::getenv("N3KOMATA_PLE_EXPERT_ASYNC_STAGE")) {
+        state.async_stage_enabled = std::atoi(stage) != 0;
+    }
+    if (state.cache_admission_enabled && state.async_stage_enabled) {
+        throw std::runtime_error("PLE synchronous cache admission and async staging cannot be combined");
+    }
+    if (state.cache_admission_enabled || state.async_stage_enabled) {
+        const char * after_env = state.async_stage_enabled ?
+                std::getenv("N3KOMATA_PLE_EXPERT_STAGE_AFTER_LAYER") :
+                std::getenv("N3KOMATA_PLE_EXPERT_CACHE_ADMISSION_AFTER_LAYER");
+        const char * after_name = state.async_stage_enabled ?
+                "N3KOMATA_PLE_EXPERT_STAGE_AFTER_LAYER" : "N3KOMATA_PLE_EXPERT_CACHE_ADMISSION_AFTER_LAYER";
+        if (after_env == nullptr || after_env[0] == '\0') {
+            throw std::runtime_error(format("%s is required with PLE Expert lookahead", after_name));
+        }
+        const long after = std::strtol(after_env, &end, 10);
+        if (end == after_env || *end != '\0' || after < 0 || after >= state.layer) {
+            throw std::runtime_error(format("invalid %s='%s'", after_name, after_env));
+        }
+        if (state.async_stage_enabled) {
+            state.stage_after_layer = (int32_t) after;
+        } else {
+            state.cache_admission_after_layer = (int32_t) after;
+        }
+    }
+    if (const char * count_env = std::getenv("N3KOMATA_PLE_EXPERT_PREFETCH_CANDIDATES")) {
+        const long parsed = std::strtol(count_env, &end, 10);
+        if (end != count_env && *end == '\0' && parsed >= 1 && parsed <= 32) {
+            state.candidate_count = (int32_t) parsed;
+        } else {
+            throw std::runtime_error(format("invalid N3KOMATA_PLE_EXPERT_PREFETCH_CANDIDATES='%s' (expected 1..32)", count_env));
+        }
+    }
+
+    std::ifstream input(path);
+    if (!input) {
+        throw std::runtime_error(format("failed to open N3KOMATA_PLE_EXPERT_PREDICTOR: %s", path));
+    }
+    std::string line;
+    std::getline(input, line); // header
+    size_t loaded = 0;
+    while (std::getline(input, line)) {
+        std::istringstream row(line);
+        std::string fields[5];
+        for (int i = 0; i < 5; ++i) {
+            if (!std::getline(row, fields[i], ',')) {
+                throw std::runtime_error("malformed row in N3KOMATA_PLE_EXPERT_PREDICTOR CSV");
+            }
+        }
+        const int32_t layer = std::stoi(fields[0]);
+        const int32_t head = std::stoi(fields[1]);
+        const int32_t ple_row = std::stoi(fields[2]);
+        const int32_t expert = std::stoi(fields[3]);
+        const float probability = std::stof(fields[4]);
+        if (layer < 0 || layer > UINT16_MAX || head < -1 || head > UINT16_MAX ||
+                ple_row < -1 || expert < 0 || probability < 0.0f) {
+            throw std::runtime_error("out-of-range value in N3KOMATA_PLE_EXPERT_PREDICTOR CSV");
+        }
+        state.rows[qwen4exp_ple_predictor_key(layer, head, ple_row)].push_back({ expert, probability });
+        loaded++;
+    }
+    if (loaded == 0) {
+        throw std::runtime_error("N3KOMATA_PLE_EXPERT_PREDICTOR CSV contains no mappings");
+    }
+    for (auto & entry : state.rows) {
+        std::sort(entry.second.begin(), entry.second.end(), [](const auto & a, const auto & b) {
+            return a.second > b.second;
+        });
+    }
+    if (const char * trace_path = std::getenv("N3KOMATA_PLE_EXPERT_PREFETCH_TRACE")) {
+        if (trace_path[0] != '\0') {
+            state.trace.open(trace_path, std::ios::out | std::ios::trunc);
+            if (!state.trace) {
+                throw std::runtime_error(format("failed to open N3KOMATA_PLE_EXPERT_PREFETCH_TRACE: %s", trace_path));
+            }
+            state.trace << "batch,token,layer,rank,expert_id,prediction_score,requested_bytes,batch_prefetch_bytes,prefetch_call_us,prefetch_end_monotonic_ns\n";
+        }
+    }
+    state.enabled = true;
+    LLAMA_LOG_INFO("qwen4exp PLE Expert predictor: loaded %zu mappings, layer=%d candidates=%d mode=%s from %s\n",
+                   loaded, state.layer, state.candidate_count,
+                   state.async_stage_enabled ? "async-stage" : state.cache_admission_enabled ? "cache-admission" : "page-hint",
+                   path);
+    return &state;
+}
+
+static qwen4exp_ple_trace_state * qwen4exp_get_ple_trace(const llama_model & model) {
+    static qwen4exp_ple_trace_state state;
+    static bool initialized = false;
+    static bool enabled = false;
+    if (!initialized) {
+        initialized = true;
+        if (const char * path = std::getenv("N3KOMATA_PLE_NGRAM_TRACE")) {
+            state.stream.open(path, std::ios::out | std::ios::trunc);
+            if (!state.stream) {
+                throw std::runtime_error(format("failed to open N3KOMATA_PLE_NGRAM_TRACE: %s", path));
+            }
+            state.stream << "batch,token,token_id,prev1,prev2,ngram_size,heads_per_ngram";
+            for (uint32_t h = 0; h < model.hparams.ple_n_heads; ++h) {
+                state.stream << ",ple_row_" << h;
+            }
+            state.stream << ",monotonic_ns\n";
+            enabled = true;
+        }
+    }
+    return enabled ? &state : nullptr;
+}
