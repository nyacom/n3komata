+static void ggml_vk_kernel_gap_init(ggml_backend_vk_context * ctx) {
+    ctx->kernel_gap_profile_enabled = getenv("N3KOMATA_VK_KERNEL_GAP_PROFILE") != nullptr;
+    if (!ctx->kernel_gap_profile_enabled) {
+        return;
+    }
+    const char * output_path = getenv("N3KOMATA_VK_KERNEL_GAP_OUTPUT");
+    if (output_path) {
+        ctx->kernel_gap_output_path = output_path;
+    }
+    ctx->kernel_gap_timestamp_period_ns = ctx->device->properties.limits.timestampPeriod;
+    const auto queue_props = ctx->device->physical_device.getQueueFamilyProperties();
+    const uint32_t queue_family = ctx->device->compute_queue->queue_family_index;
+    if (queue_family >= queue_props.size() || queue_props[queue_family].timestampValidBits == 0) {
+        ctx->kernel_gap_profile_enabled = false;
+        GGML_LOG_WARN("n3komata_vk_kernel_gap: compute queue has no timestamp support; profiling disabled\n");
+        return;
+    }
+    ctx->kernel_gap_query_capacity = 65536;
+    vk::QueryPoolCreateInfo query_create_info;
+    query_create_info.queryType = vk::QueryType::eTimestamp;
+    query_create_info.queryCount = ctx->kernel_gap_query_capacity;
+    ctx->kernel_gap_query_pool = ctx->device->device.createQueryPool(query_create_info);
+    ctx->device->device.resetQueryPool(ctx->kernel_gap_query_pool, 0, ctx->kernel_gap_query_capacity);
+    ctx->kernel_gap_calibration_valid = ggml_vk_kernel_gap_calibrate(ctx);
+    ctx->kernel_gap_init_host_raw_ns = ggml_vk_kernel_gap_host_time_ns();
+    GGML_LOG_INFO("n3komata_vk_kernel_gap: enabled process_raw_ns=%" PRIu64 " timestamp_period_ns=%.3f calibrated=%d max_deviation_ns=%" PRIu64 "\n",
+                   ctx->kernel_gap_init_host_raw_ns,
+                   ctx->kernel_gap_timestamp_period_ns, ctx->kernel_gap_calibration_valid,
+                   ctx->kernel_gap_calibration_max_deviation_ns);
+}
