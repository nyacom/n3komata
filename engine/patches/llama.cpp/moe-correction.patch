+        std::lock_guard<std::mutex> lock(transition_read_mutex);
+        GGML_ASSERT(transition_read_submitted == transition_read_consumed);
+        transition_read_layer = target_layer;
+        transition_read_ranges = std::move(ranges);
+        transition_read_submitted_at = std::chrono::steady_clock::now();
