+    const bool is_down = n3komata_profile_tensor_layer(tensor->name, "ffn_moe_down-", layer);
+    const bool is_hidden_attn = n3komata_profile_tensor_layer(tensor->name, "n3komata_hc_after_attn-", layer);
+    // The graph immediately renames the post-FFN residual to l_last-<layer>.
+    // Profile that existing node instead of adding a copy or keeping a second alias.
+    const bool is_hidden_ffn = n3komata_profile_tensor_layer(tensor->name, "l_last-", layer);
+    const bool is_hidden = is_hidden_attn || is_hidden_ffn;
+    if (!is_routes && !is_down && !is_hidden) {
+        return false;
+    }
+    if (ask) {
+        return true;
+    }
+
+    auto & profile = *static_cast<n3komata_super_expert_profile *>(user_data);
+    std::vector<uint8_t> copied;
+    const uint8_t * data = nullptr;
+    if (tensor->buffer != nullptr && ggml_backend_buffer_is_host(tensor->buffer)) {
+        data = static_cast<const uint8_t *>(tensor->data);
+    } else {
+        copied.resize(ggml_nbytes(tensor));
+        ggml_backend_tensor_get(tensor, copied.data(), 0, copied.size());
