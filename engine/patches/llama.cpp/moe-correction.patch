+bool llama_mmap_read_direct(const void * source, size_t size, llama_mmap_direct_buffer * result, int * error_code) {
+    if (error_code != nullptr) {
+        *error_code = 0;
+    }
+    if (result == nullptr || (source == nullptr && size != 0)) {
+        if (error_code != nullptr) *error_code = EINVAL;
+        return false;
+    }
+    *result = {};
+    if (size == 0) {
+        return true;
+    }
+
+#if defined(__linux__) && defined(O_DIRECT)
+    int fd = -1;
+    size_t mapping_alignment = 4096;
+    size_t file_size = 0;
+    size_t file_offset = 0;
+    const uintptr_t address = (uintptr_t) source;
+    {
+        std::lock_guard<std::mutex> lock(llama_mmap_direct_mappings_mutex);
+        for (const llama_mmap_direct_mapping & mapping : llama_mmap_direct_mappings) {
+            if (address < mapping.begin || address - mapping.begin > mapping.size) {
+                continue;
+            }
+            const size_t offset = (size_t) (address - mapping.begin);
+            if (size > mapping.size - offset) {
+                continue;
+            }
+            if (mapping.fd < 0) {
+                if (error_code != nullptr) *error_code = mapping.error_code != 0 ? mapping.error_code : ENOTSUP;
+                return false;
+            }
+            fd = mapping.fd;
+            mapping_alignment = mapping.alignment;
+            file_size = mapping.file_size;
+            file_offset = offset;
+            break;
+        }
+    }
+    if (fd < 0) {
+        if (error_code != nullptr) *error_code = ENOENT;
+        return false;
+    }
+    if (file_offset > file_size || size > file_size - file_offset || mapping_alignment == 0) {
+        if (error_code != nullptr) *error_code = EINVAL;
+        return false;
+    }
+
+    const size_t aligned_offset = file_offset - file_offset % mapping_alignment;
+    const size_t prefix = file_offset - aligned_offset;
+    if (size > SIZE_MAX - prefix) {
+        if (error_code != nullptr) *error_code = EOVERFLOW;
+        return false;
+    }
+    const size_t needed = prefix + size;
+    if (needed > SIZE_MAX - (mapping_alignment - 1)) {
+        if (error_code != nullptr) *error_code = EOVERFLOW;
+        return false;
+    }
+    const size_t aligned_size = ((needed + mapping_alignment - 1) / mapping_alignment) * mapping_alignment;
+    if (aligned_size == 0 || aligned_size > SIZE_MAX - aligned_offset) {
+        if (error_code != nullptr) *error_code = EOVERFLOW;
+        return false;
+    }
