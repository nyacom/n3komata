+static int ggml_vk_direct_copy_thread_count() {
+    const char * value = std::getenv("N3KOMATA_VK_DIRECT_COPY_THREADS");
+    if (value == nullptr || value[0] == '\0') return 2;
+    char * end = nullptr;
+    const long count = std::strtol(value, &end, 10);
+    if (end == value || *end != '\0' || count < 1 || count > ggml_vk_direct_copy_pool::max_workers) {
+        GGML_LOG_WARN("ggml_vulkan: ignoring invalid N3KOMATA_VK_DIRECT_COPY_THREADS='%s' (expected 1..%d)\n",
+                value, ggml_vk_direct_copy_pool::max_workers);
+        return 2;
+    }
+    return (int) count;
+}
