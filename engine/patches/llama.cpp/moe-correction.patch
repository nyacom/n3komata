+    }
+
+    if (is_routes) {
+        if (tensor->type != GGML_TYPE_I32 || tensor->ne[0] <= 0 || tensor->ne[1] <= 0) {
+            throw std::runtime_error("invalid N3komata route IDs for super-expert profiling");
+        }
+        const int64_t experts_per_token = tensor->ne[0];
+        const int64_t n_tokens = tensor->ne[1];
+        std::vector<int32_t> ids((size_t) experts_per_token * n_tokens);
+        for (int64_t token = 0; token < n_tokens; ++token) {
+            for (int64_t rank = 0; rank < experts_per_token; ++rank) {
+                int32_t id;
+                const size_t offset = rank * tensor->nb[0] + token * tensor->nb[1];
+                std::memcpy(&id, data + offset, sizeof(id));
+                ids[(size_t) token * experts_per_token + rank] = id;
+            }
+        }
+        profile.route_ids_by_layer[layer] = std::move(ids);
+        return true;
+    }
+
+    if (is_hidden) {
+        double max_abs = 0.0;
+        uint64_t observations = 0;
+        for (int64_t i3 = 0; i3 < tensor->ne[3]; ++i3) {
+            for (int64_t i2 = 0; i2 < tensor->ne[2]; ++i2) {
+                for (int64_t i1 = 0; i1 < tensor->ne[1]; ++i1) {
+                    for (int64_t i0 = 0; i0 < tensor->ne[0]; ++i0) {
+                        const size_t offset = i0*tensor->nb[0] + i1*tensor->nb[1] +
+                                i2*tensor->nb[2] + i3*tensor->nb[3];
+                        const double value = n3komata_profile_value(data, tensor->type, offset);
+                        if (std::isfinite(value)) {
+                            max_abs = std::max(max_abs, std::abs(value));
+                        }
+                        observations++;
+                    }
+                }
+            }
+        }
+        auto & stat = profile.hidden_state_max_by_layer_stage[{layer, is_hidden_ffn ? 1 : 0}];
+        stat.first = std::max(stat.first, max_abs);
+        stat.second += observations;
+        return true;
+    }
+
+    const auto route_it = profile.route_ids_by_layer.find(layer);
+    if (route_it == profile.route_ids_by_layer.end() || tensor->ne[1] <= 0 || tensor->ne[2] <= 0) {
+        return true;
+    }
+    const int64_t n_embd = tensor->ne[0];
+    const int64_t n_routes = tensor->ne[1];
+    const int64_t n_tokens = tensor->ne[2];
+    if ((int64_t) route_it->second.size() != n_routes * n_tokens) {
+        throw std::runtime_error("route/output shape mismatch in layer " + std::to_string(layer) +
+                ": ids=" + std::to_string(route_it->second.size()) + " down=" +
+                std::to_string(n_routes) + "x" + std::to_string(n_tokens));
+    }
+    for (int64_t token = 0; token < n_tokens; ++token) {
+        for (int64_t rank = 0; rank < n_routes; ++rank) {
+            const int32_t expert = route_it->second[(size_t) token * n_routes + rank];
+            double max_abs = 0.0;
+            for (int64_t channel = 0; channel < n_embd; ++channel) {
+                const size_t offset = channel * tensor->nb[0] + rank * tensor->nb[1] + token * tensor->nb[2];
+                const double value = n3komata_profile_value(data, tensor->type, offset);
+                if (std::isfinite(value)) {
+                    max_abs = std::max(max_abs, std::abs(value));
+                }
+            }
+            auto & stat = profile.experts[{layer, expert}];
+            stat.max_abs_down_output = std::max(stat.max_abs_down_output, max_abs);
+            stat.route_observations++;
+        }
+    }
+    return true;
+}
