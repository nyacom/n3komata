+static void ggml_vk_record_sync_fallback_event(
+        const char * operation, const ggml_tensor * tensor, size_t bytes,
+        uint64_t start_raw_ns, uint64_t end_raw_ns,
+        uint64_t total_wall_us, uint64_t total_thread_cpu_us,
+        uint64_t pre_submit_us, uint64_t api_sync_wall_us, uint64_t api_sync_thread_cpu_us,
+        uint64_t major_faults, uint64_t minor_faults) {
+    const char * output_path = std::getenv("N3KOMATA_VK_SYNC_PROFILE_OUTPUT");
+    if (output_path == nullptr || output_path[0] == '\0') {
+        return;
+    }
+
+    static std::mutex output_mutex;
+    static std::ofstream output;
+    static bool header_written = false;
+    std::lock_guard<std::mutex> lock(output_mutex);
+    if (!output.is_open()) {
+        output.open(output_path);
+        if (!output) {
+            return;
+        }
+    }
+    if (!header_written) {
+        output << "operation,tensor,bytes,start_monotonic_raw_ns,end_monotonic_raw_ns,total_wall_us,total_thread_cpu_us,pre_submit_us,api_sync_wall_us,api_sync_thread_cpu_us,major_faults,minor_faults\n";
+        header_written = true;
+    }
+    std::string tensor_name = tensor != nullptr ? tensor->name : "";
+    for (char & ch : tensor_name) {
+        if (ch == ',' || ch == '\"' || ch == '\n' || ch == '\r') {
+            ch = '_';
+        }
+    }
+    output << operation << ',' << tensor_name << ',' << bytes << ',' << start_raw_ns << ',' << end_raw_ns << ','
+           << total_wall_us << ',' << total_thread_cpu_us << ',' << pre_submit_us << ','
+           << api_sync_wall_us << ',' << api_sync_thread_cpu_us << ',' << major_faults << ',' << minor_faults << '\n';
+}
