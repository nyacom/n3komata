+            ple_stage_candidates_unused += ple_stage_expected_candidates.size();
+            ple_stage_expected_generation = 0;
+            ple_stage_expected_candidates.clear();
+            return empty;
+        }
+
+        for (int32_t expert : used) {
+            ple_stage_candidates_used++;
+            for (const ple_stage_piece & piece : ple_stage_completed.pieces) {
