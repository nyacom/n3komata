+struct ggml_vk_direct_copy_job {
+    uint8_t * dst;
+    const uint8_t * src;
+    size_t size;
+};
+
+struct ggml_vk_direct_copy_worker_stats {
+    uint64_t cpu_us = 0;
+    uint64_t major_faults = 0;
+    uint64_t minor_faults = 0;
+};
+
+// Optional persistent workers for copies into host-visible Vulkan cache banks.
+// The normal path remains a single inference-thread memcpy unless explicitly enabled.
+class ggml_vk_direct_copy_pool {
+public:
+    static constexpr int max_workers = 8;
+
+    ggml_vk_direct_copy_pool() {
+        worker_stats_.resize(max_workers);
+        workers_.reserve(max_workers);
+        for (int i = 0; i < max_workers; ++i) {
+            workers_.emplace_back([this, i] { worker(i); });
+        }
+    }
+
+    ~ggml_vk_direct_copy_pool() {
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            stopping_ = true;
+            generation_++;
+        }
+        work_cv_.notify_all();
+        for (auto & worker_thread : workers_) {
+            worker_thread.join();
+        }
+    }
+
+    void copy(const std::vector<ggml_vk_direct_copy_job> & jobs, int n_workers,
+              ggml_backend_tensor_set_batch_stats * stats) {
+        std::lock_guard<std::mutex> run_lock(run_mutex_);
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            jobs_ = &jobs;
+            next_job_.store(0, std::memory_order_relaxed);
+            active_workers_ = std::min<int>(n_workers, max_workers);
+            completed_workers_ = 0;
+            collect_stats_ = stats != nullptr;
+            for (int i = 0; i < active_workers_; ++i) worker_stats_[i] = {};
+            generation_++;
+        }
+        work_cv_.notify_all();
+        std::unique_lock<std::mutex> lock(mutex_);
+        done_cv_.wait(lock, [&] { return completed_workers_ == active_workers_; });
+        jobs_ = nullptr;
+        if (stats != nullptr) {
+            for (const auto & worker_stats : worker_stats_) {
+                stats->source_copy_thread_cpu_us += worker_stats.cpu_us;
+                stats->source_copy_major_faults += worker_stats.major_faults;
+                stats->source_copy_minor_faults += worker_stats.minor_faults;
+            }
+        }
+    }
+
+private:
+    void worker(int worker_id) {
+        uint64_t seen_generation = 0;
+        while (true) {
+            const std::vector<ggml_vk_direct_copy_job> * jobs = nullptr;
+            int n_workers = 0;
+            bool collect_stats = false;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                work_cv_.wait(lock, [&] { return stopping_ || generation_ != seen_generation; });
+                if (stopping_) return;
+                seen_generation = generation_;
+                n_workers = active_workers_;
+                if (worker_id >= n_workers) continue;
+                jobs = jobs_;
+                collect_stats = collect_stats_;
+            }
+
+            ggml_vk_direct_copy_worker_stats local_stats;
+            const uint64_t cpu_start = collect_stats ? ggml_vk_thread_cpu_time_us() : 0;
+            const uint64_t major_start = collect_stats ? ggml_vk_thread_faults(false) : 0;
+            const uint64_t minor_start = collect_stats ? ggml_vk_thread_faults(true) : 0;
+            for (size_t i = next_job_.fetch_add(1, std::memory_order_relaxed);
+                 i < jobs->size();
+                 i = next_job_.fetch_add(1, std::memory_order_relaxed)) {
+                const auto & job = (*jobs)[i];
+                std::memcpy(job.dst, job.src, job.size);
+            }
+            if (collect_stats) {
+                const uint64_t cpu_end = ggml_vk_thread_cpu_time_us();
+                const uint64_t major_end = ggml_vk_thread_faults(false);
+                const uint64_t minor_end = ggml_vk_thread_faults(true);
+                local_stats.cpu_us = cpu_end >= cpu_start ? cpu_end - cpu_start : 0;
+                local_stats.major_faults = major_end >= major_start ? major_end - major_start : 0;
+                local_stats.minor_faults = minor_end >= minor_start ? minor_end - minor_start : 0;
