+static void ggml_backend_vk_set_tensor_async_batch(ggml_backend_t backend,
+        const ggml_backend_tensor_set_batch_item * items, size_t n_items, bool prefer_direct_host,
+        ggml_backend_tensor_set_batch_stats * stats) {
+    if (n_items == 0) {
+        return;
+    }
+    auto elapsed_us = [](std::chrono::steady_clock::time_point start) {
+        return (uint64_t) std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now() - start).count();
+    };
+
+    ggml_backend_vk_context * ctx = (ggml_backend_vk_context *) backend->context;
+    struct destination_group {
+        vk_buffer buffer;
+        std::vector<vk::BufferCopy> copies;
+    };
+    std::vector<destination_group> destinations;
+    destinations.reserve(4);
+    std::vector<ggml_backend_vk_buffer_context *> tensor_buffers;
+    tensor_buffers.reserve(n_items);
+
+    const vk::MemoryPropertyFlags direct_flags =
+        vk::MemoryPropertyFlagBits::eHostVisible | vk::MemoryPropertyFlagBits::eHostCoherent;
+    bool direct_host = prefer_direct_host;
+    size_t staging_size = 0;
+    for (size_t i = 0; i < n_items; ++i) {
+        const auto & item = items[i];
+        GGML_ASSERT(item.tensor && item.tensor->buffer);
+        GGML_ASSERT(item.tensor->buffer->buft == ggml_backend_vk_get_default_buffer_type(backend) ||
+                    item.tensor->buffer->buft == ggml_backend_vk_host_buffer_type());
+        auto * buffer_context = (ggml_backend_vk_buffer_context *) item.tensor->buffer->context;
+        tensor_buffers.push_back(buffer_context);
+        if (item.size > 0) {
+            GGML_ASSERT(item.data);
+            GGML_ASSERT((item.size & 3) == 0 && "Vulkan buffer copy size must be four-byte aligned");
+            direct_host = direct_host && buffer_context->dev_buffer->ptr != nullptr &&
